    "reduce_shift": {
        "format": "long",
        "code": [
            "%r<tp>% v = r0;",
            "%r<c:uint|b:8>% b = %cast<tp,c:uint|b:8>%(v);",
            "b.r = _mm512_shuffle_i64x2(b.r, b.r, _MM_SHUFFLE(1, 0, 3, 2));",
            "v = %{{ instr_name }}<tp>%(v, %cast<c:uint|b:8,tp>%(b));",
            "b = %cast<tp,c:uint|b:8>%(v);",
            "b.r = _mm512_shuffle_i64x2(b.r, b.r, _MM_SHUFFLE(2, 3, 0, 1));",
            "v = %{{ instr_name }}<tp>%(v, %cast<c:uint|b:8,tp>%(b));",
            "{% for sh in [8, 4, 2, 1] %}{% if sh * 8 >= dt_par.n_bits %}b = %cast<tp,c:uint|b:8>%(v);",
            "b.r = _mm512_bsrli_epi128(b.r, {{ sh }});",
            "v = %{{ instr_name }}<tp>%(v, %cast<c:uint|b:8,tp>%(b));",
            "{% endif %}{% endfor %}return %getfirst<tp>%(v);"
        ]
    },
    "rshift_i8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m512i u = _mm512_xor_si512(r0.r, _mm512_set1_epi8((char)0x80));",
            "u = _mm512_and_si512(_mm512_srli_epi16(u, s0), _mm512_set1_epi8((char)(0xFF >> s0)));",
            "res.r = _mm512_sub_epi8(u, _mm512_set1_epi8((char)(0x80 >> s0)));",
            "return res;"
        ]
    },
