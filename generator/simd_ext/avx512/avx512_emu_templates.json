{
    "complex_cmul": {
        "format": "long",
        "code": [
            "// (re, re) * b -/+ (im, im) * swapped b",
            "%r<tp>% res;",
            "res.r = _mm512_fmaddsub_{{ isa_dt_par.data_ext }}({% if dt_par.n_bits == 32 %}_mm512_moveldup_ps(r0.r){% else %}_mm512_movedup_pd(r0.r){% endif %}, r1.r, _mm512_mul_{{ isa_dt_par.data_ext }}({% if dt_par.n_bits == 32 %}_mm512_movehdup_ps(r0.r){% else %}_mm512_permute_pd(r0.r, 0xFF){% endif %}, {% if dt_par.n_bits == 32 %}_mm512_permute_ps(r1.r, 0xB1){% else %}_mm512_permute_pd(r1.r, 0x55){% endif %}));",
            "return res;"
        ]
    },
    "gather_i32_64_maskz_f": {
        "format": "short",
        "code": [
            "_mm512_mask_i32gather_pd(_mm512_setzero_pd(), m0.m, r0.r, p0, 8);"
        ]
    },
    "gather_i32_64_maskz_i": {
        "format": "short",
        "code": [
            "_mm512_mask_i32gather_epi64(_mm512_setzero_si512(), m0.m, r0.r, p0, 8);"
        ]
    },
    "gather_maskz_32": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}_mask_i{{ dt_par.n_bits }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(%set0<tp>%().r,m0.m, r0.r, p0,4);"
        ]
    },
    "gather_maskz_64": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}_mask_i{{ dt_par.n_bits }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(%set0<tp>%().r,m0.m, r0.r, p0,8);"
        ]
    },
    "lshift8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = _mm512_and_si512(_mm512_slli_epi16(r0.r, s0), _mm512_set1_epi8((char)(0xFF << s0)));",
            "return res;"
        ]
    },
    "m3_s": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = {{ isa.prefix }}_mask_mov_{{ isa_dt_par.data_ext }}(rsrc.r, m0.m, {{ isa.prefix }}_{{ instr_name }}_{{ isa_dt_par.data_ext }}(r0.r, r1.r, r2.r));",
            "return res;"
        ]
    },
    "mul64": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m512i lo = _mm512_mul_epu32(r0.r, r1.r);",
            "__m512i t1 = _mm512_mul_epu32(_mm512_srli_epi64(r0.r, 32), r1.r);",
            "__m512i t2 = _mm512_mul_epu32(r0.r, _mm512_srli_epi64(r1.r, 32));",
            "res.r = _mm512_add_epi64(lo, _mm512_slli_epi64(_mm512_add_epi64(t1, t2), 32));",
            "return res;"
        ]
    },
    "mul8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m512i even = _mm512_mullo_epi16(r0.r, r1.r);",
            "__m512i odd = _mm512_mullo_epi16(_mm512_srli_epi16(r0.r, 8), _mm512_srli_epi16(r1.r, 8));",
            "res.r = _mm512_or_si512(_mm512_slli_epi16(odd, 8), _mm512_and_si512(even, _mm512_set1_epi16(0x00FF)));",
            "return res;"
        ]
    },
    "pow2_sllv": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = _mm512_sllv_epi{{ dt_par.n_bits }}(_mm512_set1_epi{{ dt_par.n_bits }}(1), r0.r);",
            "return res;"
        ]
    },
    "rea_compress_store": {
        "format": "long",
        "code": [
            "// compressed in a register, then a store of the first count lanes (exact)",
            "const unsigned long long n = (unsigned long long)__builtin_popcountll((unsigned long long)m0.m);",
            "{{ isa.prefix }}_mask_storeu_{{ isa_dt_par.data_ext if dt_par.category == 'float' else 'epi' ~ dt_par.n_bits }}(p0, ({{ isa_dt_par.msk }})(n >= 64 ? ~0ULL : (1ULL << n) - 1), {{ isa.prefix }}_maskz_compress_{{ isa_dt_par.data_ext if dt_par.category == 'float' else 'epi' ~ dt_par.n_bits }}(m0.m, r0.r));",
            "return (int32_t)n;"
        ]
    },
    "rea_perm2_32": {
        "format": "short",
        "code": "{{ isa.prefix }}_permutex2var_{{ isa_dt_par.data_ext if dt_par.category == 'float' else 'epi32' }}(r0.r, {{ isa.prefix }}_set_epi32({{ instr_name }}), r1.r);"
    },
    "rea_perm2_64": {
        "format": "short",
        "code": "{{ isa.prefix }}_permutex2var_{{ isa_dt_par.data_ext if dt_par.category == 'float' else 'epi64' }}(r0.r, {{ isa.prefix }}_set_epi64({{ instr_name }}), r1.r);"
    },
