    "lshift8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = _mm512_and_si512(_mm512_slli_epi16(r0.r, s0), _mm512_set1_epi8((char)(0xFF << s0)));",
            "return res;"
        ]
    },
    "m3_s": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = {{ isa.prefix }}_mask_mov_{{ isa_dt_par.data_ext }}(rsrc.r, m0.m, {{ isa.prefix }}_{{ instr_name }}_{{ isa_dt_par.data_ext }}(r0.r, r1.r, r2.r));",
            "return res;"
        ]
    },
    "mul64": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m512i lo = _mm512_mul_epu32(r0.r, r1.r);",
            "__m512i t1 = _mm512_mul_epu32(_mm512_srli_epi64(r0.r, 32), r1.r);",
            "__m512i t2 = _mm512_mul_epu32(r0.r, _mm512_srli_epi64(r1.r, 32));",
            "res.r = _mm512_add_epi64(lo, _mm512_slli_epi64(_mm512_add_epi64(t1, t2), 32));",
            "return res;"
        ]
    },
    "mul8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m512i even = _mm512_mullo_epi16(r0.r, r1.r);",
            "__m512i odd = _mm512_mullo_epi16(_mm512_srli_epi16(r0.r, 8), _mm512_srli_epi16(r1.r, 8));",
            "res.r = _mm512_or_si512(_mm512_slli_epi16(odd, 8), _mm512_and_si512(even, _mm512_set1_epi16(0x00FF)));",
            "return res;"
        ]
    },
    "pow2_sllv": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "res.r = _mm512_sllv_epi{{ dt_par.n_bits }}(_mm512_set1_epi{{ dt_par.n_bits }}(1), r0.r);",
            "return res;"
        ]
    },
