{
    "ncvt": [
        {
            "datatypes": ["int16", "int32", "int64", "uint16", "uint32", "uint64"],
            "code": [
                "{% set d = isa.datatypes[ctx.dt_ret].data_ext %}{% set s = isa_dt.data_ext %}%r<tr>% res;",
                "res.r = svuzp1_{{ d }}(svreinterpret_{{ d }}_{{ s }}(r0.r1.r), svreinterpret_{{ d }}_{{ s }}(r0.r2.r));",
                "return res;"
            ]
        },
        {
            "datatypes": ["float64"],
            "code": [
                "%r<tr>% res;",
                "res.r = svuzp1_f32(svcvt_f32_f64_x(svptrue_b64(), r0.r1.r), svcvt_f32_f64_x(svptrue_b64(), r0.r2.r));",
                "return res;"
            ]
        }
    ],
    "wcvt": [
        {
            "datatypes": ["int8", "int16", "int32", "uint8", "uint16", "uint32"],
            "code": [
                "%r<tr>% res;",
                "res.r1.r = svunpklo_{{ isa.datatypes[ctx.dt_ret].data_ext }}(r0.r);",
                "res.r2.r = svunpkhi_{{ isa.datatypes[ctx.dt_ret].data_ext }}(r0.r);",
                "return res;"
            ]
        },
        {
            "datatypes": ["float32"],
            "code": [
                "%r<tr>% res;",
                "res.r1.r = svcvt_f64_f32_x(svptrue_b64(), svzip1_f32(r0.r, r0.r));",
                "res.r2.r = svcvt_f64_f32_x(svptrue_b64(), svzip2_f32(r0.r, r0.r));",
                "return res;"
            ]
        }
    ]
}
