    "testz": {
        "format": "long",
        "code": [
            "\treturn !{{ isa.prefix }}{{ instr_name }}(svptrue_{{ isa_dt_par.data_ext_logi }}(), m0.m);"
        ]
    },
    "tomsk": {
        "format": "long",
        "code": [
            "%r<tp>% r1 = %set1<tp>%(0);",
            "return %cmpneq<tp>%(r1,r0);"
        ]
    },
    "toreg-16": {
        "format": "long",
        "code": [
            "%r<tp>% one  = %set1<tp>%(0xFFFF);",
            "%r<tp>% zero = %set1<tp>%(0);",
