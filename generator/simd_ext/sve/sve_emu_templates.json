{
    "and_all_float": {
        "format": "long",
        "code": [
            "%r<c:int>% a = %cast<tp,c:int|b:tp>%(r0);",
            "%r<c:int>% b = %cast<tp,c:int|b:tp>%(r1);",
            "%r<c:int>% res = %andb<c:int>%(a,b);",
            "return %cast<c:int|b:tp,tp>%(res);"
        ]
    },
    "andb": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext}}_z(svptrue_{{ isa_dt_par.data_ext_logi }}(), r0.r, r1.r);"
        ]
    },
    "andb_k": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}{{ instr_name }}_z(svptrue_{{ isa_dt_par.data_ext_logi }}(), m0.m, m1.m);"
        ]
    },
    "cast_k": {
        "format": "short",
        "code": [
            " m0.m;"
        ]
    },
    "get": {
        "format": "long",
        "code": [
            "%v<tp>% t[%N<tp>%];",
            "%storeu<tp>%(t, r0);",
            "return t[v0];"
        ]
    },
    "get_k": {
        "format": "long",
        "code": [
            "%v<tp>% tmp[%N<tp>%];",
            "%r<tp>% rmsk =%toreg<tp>%(m0);",
            "%storeu<tp>%(tmp, rmsk);",
            "return (int32_t) tmp[v0];"
        ]
    },
    "getfirst": {
        "format": "long",
        "code": [
            "return %get<tp>%(r0, 0);"
        ]
    },
    "hadd": {
        "format": "long",
        "code": [
            "const %v<tp>% val = %hadd_to_scal<tp>%(r0);",
            "return %set1<tp>%(val);"
        ]
    },
    "load": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(svptrue_{{ isa_dt_par.data_ext_logi }}(), ({{ isa_dt_par.to_ptr }}*) p0);"
        ]
    },
    "notb_k": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}{{ instr_name }}_z(svptrue_{{ isa_dt_par.data_ext_logi }}(), m0.m);"
        ]
    },
    "reduce": {
        "format": "long",
        "code": [
            "return {{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(svptrue_{{ isa_dt_par.data_ext_logi }}(), r0.r);"
        ]
    },
    "set_by_load": {
        "format": "long",
        "code": [
            "return %load<tp>%(vals);"
        ]
    },
    "set_k-32": {
        "format": "long",
        "code": [
            "%v<c:uint>% t[%N<tp>%];",
            "for (int i = 0; i < %N<tp>%; ++i) {",
            "\tt[i] = vals[i] ? 0xFFFFFFFF : 0;",
            "}",
            "%r<c:uint>% r0_32 = %set<c:uint>%((%v<c:uint>%*) t);",
            "%r<c:uint>% r1_32 = %set1<c:uint>%(0xFFFFFFFF);",
            "return %cast_k<c:uint|b:tp,tp>%(%cmpeq<c:uint|b:tp>%(r0_32, r1_32));"
        ]
    },
    "set_k-64": {
        "format": "long",
        "code": [
            "%v<c:uint>% t[%N<tp>%];",
            "for (int i = 0; i < %N<tp>%; ++i) {",
            "\tt[i] = vals[i] ? (uint64_t)0xFFFFFFFFFFFFFFFF : (uint64_t)0;",
            "}",
            "%r<c:uint>% r0_32 = %set<c:uint>%((%v<c:uint>%*) t);",
            "%r<c:uint>% r1_32 = %set1<c:uint>%((%v<c:uint>%) 0xFFFFFFFFFFFFFFFF);",
            "return %cast_k<c:uint|b:tp,tp>%(%cmpeq<c:uint|b:tp>%(r0_32, r1_32));"
        ]
    },
    "std_2_reg_in_no_msk": {
        "format": "short",
        "code": [
            "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(svptrue_{{ isa_dt_par.data_ext_logi }}(), r0.r, r1.r);"
        ]
    },
