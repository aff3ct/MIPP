{
    "combine": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "res.vd = svsplice_{{ isa_dt.data_ext }}(svwhilelt_b{{ dt.n_bits }}_s32(0, %N<tp>%), vd0.vd, vd1.vd);",
                "return res;"
            ]
        }
    ],
    "combine_k": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "svuint{{ dt.n_bits }}_t v0 = svdup_n_u{{ dt.n_bits }}_z(vm0.vm, 1);",
                "svuint{{ dt.n_bits }}_t v1 = svdup_n_u{{ dt.n_bits }}_z(vm1.vm, 1);",
                "svuint{{ dt.n_bits }}_t v = svsplice_u{{ dt.n_bits }}(svwhilelt_b{{ dt.n_bits }}_s32(0, %N<tp>%), v0, v1);",
                "%vm<tr>% res;",
                "res.vm = svcmpne_n_u{{ dt.n_bits }}(svptrue_b{{ dt.n_bits }}(), v, 0);",
                "return res;"
            ]
        }
    ],
    "hi": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "res.vd = svext_{{ isa_dt.data_ext }}(vd0.vd, vd0.vd, %N<tp|m:tp/2>%);",
                "return res;"
            ]
        }
    ],
    "hi_k": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "svuint{{ dt.n_bits }}_t v = svdup_n_u{{ dt.n_bits }}_z(vm0.vm, 1);",
                "v = svext_u{{ dt.n_bits }}(v, v, %N<tp|m:tp/2>%);",
                "%vm<tr>% res;",
                "res.vm = svcmpne_n_u{{ dt.n_bits }}(svptrue_b{{ dt.n_bits }}(), v, 0);",
                "return res;"
            ]
        }
    ],
    "lo": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "res.vd = vd0.vd;",
                "return res;"
            ]
        }
    ],
    "lo_k": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "%vm<tr>% res;",
                "res.vm = vm0.vm;",
                "return res;"
            ]
        }
    ],
    "load|loadu": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "svbool_t pg = svwhilelt_b{{ dt.n_bits }}_s32(0, %N<tp>%);",
                "%vd<tr>% res;",
                "res.vd = svld1_{{ isa_dt.data_ext }}(pg, p0);",
                "return res;"
            ]
        }
    ],
    "ncvt": [
        {
            "datatypes": [
                "int16",
                "int32",
                "int64",
                "uint16",
                "uint32",
                "uint64"
            ],
            "variants": [
                "u"
            ],
            "code": [
                "{% set d = isa.datatypes[ctx.dt_ret].data_ext %}{% set s = isa_dt.data_ext %}%vd<tr>% res;",
                "{{ isa.datatypes[ctx.dt_ret].reg }} x = svreinterpret_{{ d }}_{{ s }}(vd0.vd);",
                "res.vd = svuzp1_{{ d }}(x, x);",
                "return res;"
            ]
        },
        {
            "datatypes": [
                "float64"
            ],
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "svfloat32_t x = svcvt_f32_f64_x(svptrue_b64(), vd0.vd);",
                "res.vd = svuzp1_f32(x, x);",
                "return res;"
            ]
        }
    ],
    "ncvts": [
        {
            "datatypes": [
                "int16",
                "int32",
                "int64",
                "uint16",
                "uint32",
                "uint64"
            ],
            "variants": [
                "u"
            ],
            "code": [
                "{% set d = isa.datatypes[ctx.dt_ret].data_ext %}{% set s = isa_dt.data_ext %}{% set D = ctx.dt_ret | upper %}",
                "svbool_t pg = svptrue_{{ isa_dt.data_ext_logi }}();",
                "{{ isa_dt.reg }} c = svmin_n_{{ s }}_x(pg, vd0.vd, {{ D }}_MAX);",
                "{% if not ctx.dt_ret.startswith('u') %}c = svmax_n_{{ s }}_x(pg, c, {{ D }}_MIN);{% endif %}",
                "%vd<tr>% res;",
                "{{ isa.datatypes[ctx.dt_ret].reg }} x = svreinterpret_{{ d }}_{{ s }}(c);",
                "res.vd = svuzp1_{{ d }}(x, x);",
                "return res;"
            ]
        }
    ],
    "store|storeu": [
        {
            "variants": [
                "u"
            ],
            "code": [
                "svbool_t pg = svwhilelt_b{{ dt.n_bits }}_s32(0, %N<tp>%);",
                "svst1_{{ isa_dt.data_ext }}(pg, p0, vd0.vd);"
            ]
        }
    ],
    "wcvt": [
        {
            "datatypes": [
                "int8",
                "int16",
                "int32",
                "uint8",
                "uint16",
                "uint32"
            ],
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "res.vd = svunpklo_{{ isa.datatypes[ctx.dt_ret].data_ext }}(vd0.vd);",
                "return res;"
            ]
        },
        {
            "datatypes": [
                "float32"
            ],
            "variants": [
                "u"
            ],
            "code": [
                "%vd<tr>% res;",
                "res.vd = svcvt_f64_f32_x(svptrue_b64(), svzip1_f32(vd0.vd, vd0.vd));",
                "return res;"
            ]
        }
    ]
}
