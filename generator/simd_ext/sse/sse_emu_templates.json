    "cmpgt64_sse2": {
        "format": "long",
        "code": [
            "%m<tr>% res;",
            "__m128i flip = _mm_set_epi32(0, (int32_t)0x80000000, 0, (int32_t)0x80000000);",
            "__m128i a = _mm_xor_si128(r0.r, flip);",
            "__m128i b = _mm_xor_si128(r1.r, flip);",
            "__m128i gt = _mm_cmpgt_epi32(a, b);",
            "__m128i eq = _mm_cmpeq_epi32(a, b);",
            "__m128i gt_lo = _mm_shuffle_epi32(gt, _MM_SHUFFLE(2, 2, 0, 0));",
            "res.m = _mm_shuffle_epi32(_mm_or_si128(gt, _mm_and_si128(eq, gt_lo)), _MM_SHUFFLE(3, 3, 1, 1));",
            "return res;"
        ]
    },
    "cvt_f32_u32": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "__m128 two31 = _mm_set1_ps(2147483648.0f);",
            "__m128i big = _mm_castps_si128(_mm_cmpge_ps(r0.r, two31));",
            "__m128i lo = _mm_cvttps_epi32(r0.r);",
            "__m128i hi = _mm_xor_si128(_mm_cvttps_epi32(_mm_sub_ps(r0.r, two31)), _mm_set1_epi32((int32_t)0x80000000));",
            "res.r = _mm_or_si128(_mm_and_si128(big, hi), _mm_andnot_si128(big, lo));",
            "return res;"
        ]
    },
    "cvt_f64_i64": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "%r<tp>% t = %trunc<tp>%(r0);",
            "%r<tp>% y;",
            "y.r = _mm_mul_pd(t.r, _mm_set1_pd(2.3283064365386962890625e-10));",
            "%r<tp>% ty = %trunc<tp>%(y);",
            "__m128d hi_d = _mm_sub_pd(ty.r, _mm_and_pd(_mm_cmpgt_pd(ty.r, y.r), _mm_set1_pd(1.0)));",
            "__m128d lo_d = _mm_sub_pd(t.r, _mm_mul_pd(hi_d, _mm_set1_pd(4294967296.0)));",
            "__m128d two31 = _mm_set1_pd(2147483648.0);",
            "__m128i flip = _mm_set1_epi32((int32_t)0x80000000);",
            "__m128i lo_u = _mm_xor_si128(_mm_cvttpd_epi32(_mm_sub_pd(lo_d, two31)), flip);",
            "__m128i hi_i = _mm_cvttpd_epi32(hi_d);",
            "res.r = _mm_unpacklo_epi32(lo_u, hi_i);",
            "return res;"
