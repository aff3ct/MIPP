            "__m128i p02 = _mm_mul_epu32(r0.r, r1.r);",
            "__m128i p13 = _mm_mul_epu32(_mm_srli_si128(r0.r, 4), _mm_srli_si128(r1.r, 4));",
            "res.r = _mm_unpacklo_epi32(_mm_shuffle_epi32(p02, _MM_SHUFFLE(0, 0, 2, 0)), _mm_shuffle_epi32(p13, _MM_SHUFFLE(0, 0, 2, 0)));",
            "return res;"
