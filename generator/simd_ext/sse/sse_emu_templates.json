    "cmple_u_emu": {
        "format": "long",
        "code": "return %notb_k<tp>%(%cmpgt<tp>%(r0, r1));"
    },
    "cmplt_u_emu": {
        "format": "long",
        "code": "return %cmpgt<tp>%(r1, r0);"
    },
    "cmpneq": {
        "format": "long",
        "code": "return %notb_k<tp>%(%cmpeq<tp>%(r0, r1));"
    },
    "fmadd": {
        "format": "long",
        "code": [
            "%r<tp>% res = %mul<tp>%(r0, r1);",
            "res = %add<tp>%(res, r2);",
            "return res;"
        ]
    },
    "get": {
        "format": "long",
        "code": [
            "%v<tp>% t[%N<tp>%];",
            "%storeu<tp>%(t, r0);",
            "return t[v0];"
        ]
    },
    "get_k": {
        "format": "long",
        "code": [
            "%v<tp>% tmp[%N<tp>%];",
            "%r<tp>% rmsk = %toreg<tp>%(m0);",
            "%storeu<tp>%(tmp, rmsk);",
            "return (int32_t) tmp[v0];"
        ]
    },
