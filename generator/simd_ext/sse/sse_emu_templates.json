    "mul64_sse2": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m128i lo = _mm_mul_epu32(r0.r, r1.r);",
            "__m128i t1 = _mm_mul_epu32(_mm_srli_epi64(r0.r, 32), r1.r);",
            "__m128i t2 = _mm_mul_epu32(r0.r, _mm_srli_epi64(r1.r, 32));",
            "res.r = _mm_add_epi64(lo, _mm_slli_epi64(_mm_add_epi64(t1, t2), 32));",
            "return res;"
        ]
