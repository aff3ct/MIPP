{
    "cmpeq64_sse2": {
        "format": "long",
        "code": [
            "%m<tr>% res;",
            "__m128i eq32 = _mm_cmpeq_epi32(r0.r, r1.r);",
            "res.m = _mm_and_si128(eq32, _mm_shuffle_epi32(eq32, _MM_SHUFFLE(2, 3, 0, 1)));",
            "return res;"
        ]
