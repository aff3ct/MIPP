    "trunc_magic": {
        "format": "long",
        "code": [
            "{% set s = 'ps' if dt_par.n_bits == 32 else 'pd' %}{% set mg = '8388608.0f' if dt_par.n_bits == 32 else '4503599627370496.0' %}{% set one = '1.0f' if dt_par.n_bits == 32 else '1.0' %}%r<tp>% res;",
            "{{ isa_dt_par.reg }} sign = _mm_and_{{ s }}(r0.r, _mm_set1_{{ s }}(-0.0));",
            "{{ isa_dt_par.reg }} ax = _mm_xor_{{ s }}(r0.r, sign);",
            "{{ isa_dt_par.reg }} magic = _mm_set1_{{ s }}({{ mg }});",
            "{{ isa_dt_par.reg }} t = _mm_sub_{{ s }}(_mm_add_{{ s }}(ax, magic), magic);",
            "t = _mm_sub_{{ s }}(t, _mm_and_{{ s }}(_mm_cmpgt_{{ s }}(t, ax), _mm_set1_{{ s }}({{ one }})));",
            "{{ isa_dt_par.reg }} small = _mm_cmplt_{{ s }}(ax, magic);",
            "t = _mm_or_{{ s }}(_mm_and_{{ s }}(small, t), _mm_andnot_{{ s }}(small, ax));",
            "res.r = _mm_or_{{ s }}(t, sign);",
            "return res;"
        ]
