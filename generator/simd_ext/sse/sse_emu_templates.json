        "format": "long",
        "code": [
            "%r<c:int|b:tp>% r0u;",
            "r0u = %set1<c:int|b:tp>%((int{{ dt_par.n_bits }}_t)v0);",
            "return %cast<c:int|b:tp,tp>%(r0u);"
        ]
