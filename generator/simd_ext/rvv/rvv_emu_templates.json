        "code": "return %testz_2<b:tp|c:tp|m:tp>%(m0) && %testz_2<b:tp|c:tp|m:tp>%(m1);"
    },
    "hmul_int_uint": {
        "format": "long",
        "code": [
            "%r<tp>% tmp; ",
            "tmp.r = r0.r;",
            "size_t vl = %N<tp>%;",
            "for (size_t off = 1; off < vl; off <<= 1) {",
            "\t%r<tp>% shifted; ",
            "\tshifted.r =  {{isa.prefix}}_vslidedown_vx_{{isa_dt_par.data_ext}}(tmp.r,off,vl);",
            "\ttmp.r = {{isa.prefix}}_{{instr_name}}_vv_{{isa_dt_par.data_ext}}(tmp.r, shifted.r, vl);",
            "}",
            "//return {{isa.prefix}}_vmv_x_s_{{isa_dt_par.data_ext}}_{{isa_dt_par.reg_dt_ext}}(tmp.r);",
            "return {{isa.prefix}}_vmv_x_s_{{isa_dt_par.data_ext}}_{{isa_dt_par.reg_dt_ext}}(tmp.r);"
        ]
    },
    "hmul_float": {
        "format": "long",
        "code": [
            "%r<tp>% tmp;",
            "tmp.r = r0.r;",
            "size_t vl = %N<tp>%;",
            "for (size_t off = 1; off < vl; off <<= 1) {",
            "\t%r<tp>% shifted;",
            "\tshifted.r =  {{isa.prefix}}_vslidedown_vx_{{isa_dt_par.data_ext}}(tmp.r,off,vl);",
            "\ttmp.r = {{isa.prefix}}_{{instr_name}}_vv_{{isa_dt_par.data_ext}}(tmp.r, shifted.r, vl);",
            "}",
            "//return {{isa.prefix}}_vfmv_f_s_{{isa_dt_par.data_ext}}_{{isa_dt_par.reg_dt_ext}}(tmp.r);",
            "return {{isa.prefix}}_vfmv_f_s_{{isa_dt_par.data_ext}}_{{isa_dt_par.reg_dt_ext}}(tmp.r);"
        ]
    },
    "hadd_to_scal": {
        "format": "long",
        "code": "return %hadd<tp>%(r0);"
    },
    "cast": {
        "format": "short",
        "code": "{% if isa_dt_par.data_ext != isa_dt_ret.data_ext -%} {{ isa.prefix }}_{{ instr_name }}_v_{{isa_dt_par.data_ext}}_{{isa_dt_ret.data_ext}}(r0.r);{% else -%} r0.r;{% endif %}"
    },
    "cast_float_other": {
        "format": "long",
        "code": [
            "%r<c:int|b:tp>% rint = %cast<tp,c:int|b:tp>%(r0); ",
            "%r<c:int|b:tr>% rint2 = %cast<c:int|b:tp,c:int|b:tr>%(rint);",
            "",
            "return %cast<c:int|b:tr,tr>%(rint2);"
        ]
    },
