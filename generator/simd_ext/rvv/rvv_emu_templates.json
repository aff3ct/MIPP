            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((%v<c:int|b:tp>%) 0x8000000000000000));",
            "return %andb<tp>%(r0, rm);"
        ]
    },
    "msb-32": {
