    "gather": {
        "format": "long",
        "code": [
            "{%- set w = isa_dt_par.width | int -%}",
            "{%- set ls = isa_dt_par.data_ext[3:] -%}{%- set ws = {'mf2': 'm1', 'm1': 'm2', 'm2': 'm4', 'm4': 'm8', 'm8': ''}[ls] -%}",
            "{%- if w == 8 %}{% set mode = 'e8' %}{% elif w == 16 and ls != 'm8' %}{% set mode = 'wide' %}{% elif w == 16 %}{% set mode = 'split' %}{% else %}{% set mode = 'same' %}{% endif -%}",
            "{% if mode == 'wide' -%}",
            "// widen the element indices to 32-bit byte offsets: idx * 2 overflows 16 bits from idx = 2^15",
            "vuint32{{ ws }}_t off = {{ isa.prefix }}_vwmulu_vx_u32{{ ws }}(r0.r, sizeof({{ isa_dt_par.to_ptr }}), %N<tp>%);",
            "{% elif mode == 'split' -%}",
            "// LMUL 8: 32-bit offsets would need LMUL 16, so the lanes with an index >= 2^15 are accessed",
            "// from p0 + 2^15 in a second pass, with 15-bit indices (byte offsets < 2^16)",
            "{{ isa_dt_par.msk }} hi = {{ isa.prefix }}_vmsgeu_vx_{{ isa_dt_par.uint_data_ext }}_{{ isa_dt_par.data_ext_logi }}(r0.r, 32768, %N<tp>%);",
            "%r<c:uint|b:tp>% off;",
            "off.r = {{ isa.prefix }}_vsll_vx_{{ isa_dt_par.uint_data_ext }}({{ isa.prefix }}_vand_vx_{{ isa_dt_par.uint_data_ext }}(r0.r, 0x7FFF, %N<tp>%), 1, %N<tp>%);",
            "{% elif mode == 'same' -%}",
            "// r0 holds element indices: convert them to byte offsets",
            "%r<c:uint|b:tp>% off;",
            "off.r = {{ isa.prefix }}_vmul_vx_{{ isa_dt_par.uint_data_ext }}(r0.r, sizeof({{ isa_dt_par.to_ptr }}), %N<tp>%);",
            "{% endif -%}",
            "%r<tp>% res;",
            "{% if mode == 'split' -%}",
            "// first pass on every lane: the lanes with idx >= 2^15 read a valid element (idx - 2^15 < idx), overwritten below",
            "res.r = {{ isa.prefix }}_vluxei{% if mode == 'wide' %}32{% else %}{{ isa_dt_par.width }}{% endif %}_v_{{ isa_dt_par.data_ext }}(p0, off.r, %N<tp>%);",
            "res.r = {{ isa.prefix }}_vluxei{% if mode == 'wide' %}32{% else %}{{ isa_dt_par.width }}{% endif %}_v_{{ isa_dt_par.data_ext }}_mu(hi, res.r, p0 + 32768, off.r, %N<tp>%);",
            "{% else -%}",
            "res.r = {{ isa.prefix }}_vluxei{% if mode == 'wide' %}32{% else %}{{ isa_dt_par.width }}{% endif %}_v_{{ isa_dt_par.data_ext }}(p0, {% if mode == 'wide' %}off{% elif mode == 'e8' %}r0.r{% else %}off.r{% endif %}, %N<tp>%);",
            "{% endif -%}",
            "return res;"
        ]
    },
