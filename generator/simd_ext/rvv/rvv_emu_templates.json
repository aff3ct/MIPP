            "{{ isa.prefix }}_vsuxei{% if mode == 'wide' %}32{% else %}{{ isa_dt_par.width }}{% endif %}_v_{{ isa_dt_par.data_ext }}_m(hi, p0 + 32768, off.r, blended.r, %N<tp>%);",
            "{% else -%}",
            "{{ isa.prefix }}_vsuxei{% if mode == 'wide' %}32{% else %}{{ isa_dt_par.width }}{% endif %}_v_{{ isa_dt_par.data_ext }}(p0, {% if mode == 'wide' %}off{% elif mode == 'e8' %}r0.r{% else %}off.r{% endif %}, blended.r, %N<tp>%);",
            "{%- endif %}"
        ]
    },
    "set0_k": {
        "format": "long",
        "code": [
            "%r<tp>% tmp;",
            "tmp = %set0<tp>%();",
            "return %cmpneq<tp>%(tmp,tmp);"
        ]
    },
    "set_k": {
        "format": "long",
        "code": [
            "size_t nbytes = (%N<tp>% + 7) / 8;  ",
            "//c++ doesn't want me to use vla.",
            "uint8_t *packed =  (uint8_t * ) malloc(sizeof(uint8_t) * nbytes);",
            "memset(packed, 0, nbytes);    ",
            "for(unsigned i = 0 ; i < %N<tp>%; i++){",
            "\tif (vals[i] != 0) packed[i >> 3] |= (uint8_t)1 << (i & 7);",
            "}",
            "%m<tp>% out;",
            "out.m = {{isa.prefix}}_vlm_v_{{isa_dt_par.data_ext_logi}}(packed, %N<tp>%);",
            "free(packed);",
            "return out;"
        ]
    },
    "shift_float": {
        "format": "long",
        "code": [
            "%r<c:uint|b:tp>% tmp1;",
            "tmp1.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.data_ext}}_{{isa_dt_par.uint_data_ext}}(r0.r);",
            "tmp1.r = {{ isa.prefix }}_v{{ instr_name }}_vx_{{ isa_dt_par.uint_data_ext }}(tmp1.r, s0, %N<tp>%);",
            "%r<tp>% ret;",
            "ret.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.uint_data_ext}}_{{isa_dt_par.data_ext}}(tmp1.r);",
            "return ret;"
        ]
    },
    "shift_float_msk": {
        "format": "long",
        "code": [
            "%r<c:uint|b:tp>% tmp1;",
            "tmp1.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.data_ext}}_{{isa_dt_par.uint_data_ext}}(r0.r);",
            "tmp1.r = {{ isa.prefix }}_v{{ instr_name }}_vx_{{ isa_dt_par.uint_data_ext }}_mu(m0.m, tmp1.r, tmp1.r, s0, %N<tp>%);",
            "%r<tp>% ret;",
            "ret.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.uint_data_ext}}_{{isa_dt_par.data_ext}}(tmp1.r);",
            "return ret;"
        ]
    },
    "shift_float_msks": {
        "format": "long",
        "code": [
            "%r<c:uint|b:tp>% tmp1;",
            "%r<c:uint|b:tp>% rsrc_u;",
            "rsrc_u.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.data_ext}}_{{isa_dt_par.uint_data_ext}}(rsrc.r);",
            "",
            "tmp1.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.data_ext}}_{{isa_dt_par.uint_data_ext}}(r0.r);",
            "tmp1.r = {{ isa.prefix }}_v{{ instr_name }}_vx_{{ isa_dt_par.uint_data_ext }}_mu(m0.m, rsrc_u.r, tmp1.r, s0, %N<tp>%);",
            "%r<tp>% ret;",
            "ret.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.uint_data_ext}}_{{isa_dt_par.data_ext}}(tmp1.r);",
            "return ret;"
        ]
    },
    "shift_float_mskz": {
        "format": "long",
        "code": [
            "%r<c:uint|b:tp>% tmp1;",
            "%r<c:uint|b:tp>% zeroes = %set0<c:uint|b:tp>%();",
            "tmp1.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.data_ext}}_{{isa_dt_par.uint_data_ext}}(r0.r);",
            "tmp1.r = {{ isa.prefix }}_v{{ instr_name }}_vx_{{ isa_dt_par.uint_data_ext }}_mu(m0.m, zeroes.r, tmp1.r, s0, %N<tp>%);",
            "%r<tp>% ret;",
            "ret.r = {{ isa.prefix }}_vreinterpret_v_{{isa_dt_par.uint_data_ext}}_{{isa_dt_par.data_ext}}(tmp1.r);",
            "return ret;"
        ]
    },
    "shift_scalar_mskz": {
        "format": "long",
        "code": [
            "%r<tp>% tmp;",
            "tmp = %set0<tp>%();",
            "tmp.r = {{isa.prefix}}_v{{instr_name}}_vx_{{isa_dt_par.data_ext}}_mu(m0.m, tmp.r, r0.r, s0, %N<tp>%);",
            "return tmp;"
        ]
    },
    "store_mskz": {
        "format": "long",
        "code": [
            "%r<tp>% tmp;",
            "tmp = %set0<tp>%();",
            "tmp.r = {{ isa.prefix }}_vmerge_vvm_{{ isa_dt_par.data_ext }}(tmp.r, r0.r, m0.m, %N<tp>%);",
            "// store w regular vse",
            "{{ isa.prefix }}_vse{{ isa_dt_par.width}}_v_{{ isa_dt_par.data_ext }}(({{ isa_dt_par.to_ptr }}*) p0, tmp.r , %N<tp>%);"
        ]
    },
    "trunc_float_rtz": {
        "format": "long",
        "code": [
            "%r<c:int|b:tp>% tmp;",
            "tmp.r = {{ isa.prefix }}_vfcvt_x_f_v_{{ isa_dt_par.int_data_ext }}_rm(r0.r, __RISCV_FRM_RTZ, %N<tp>%);",
            "%r<tp>% rf;",
            "rf.r = {{ isa.prefix }}_vfcvt_f_x_v_{{ isa_dt_par.data_ext }}(tmp.r, %N<tp>%);",
            "// |x| >= 2^p (and NaN, Inf) are already integers: kept",
            "%m<tp>% small = %cmplt<tp>%(%abs<tp>%(r0), %set1<tp>%({{ '4503599627370496.0' if dt_par.n_bits == 64 else '8388608.0f' }}));",
            "return %select<tp>%(small, rf, r0);"
        ]
    }
}
