    "cast_k_same_size": {
        "format": "short",
        "code": "m0.m;"
    },
    "cast_k_diff_size": {
        "format": "long",
        "code": [
            "%r<tp>% r0 =  %toreg<tp>%(m0);",
            "%r<tr>% r1 = %cast<tp,tr>%(r0);",
            "%r<c:uint|b:tr>% rtmp0;",
            "rtmp0.r = {{isa.prefix}}_vid_v_{{isa_dt_ret.data_ext}}(%N<tp>%);",
            "%r<tr>% rtmp = %cast<c:uint|b:tr,tr>%(rtmp0);",
            "%r<tr>% rtmp1;",
            "rtmp1 = %set0<tr>%();",
            "rtmp = %andb<tr>%(rtmp,rtmp1);",
            "r1 = %andb<tr>%(r1,rtmp);",
            "return %tomsk<tr>%(r1);"
        ]
    },
    "cast_k_narrowing": {
        "format": "long",
        "code": [
            "%r<tp>% r0 = %toreg<tp>%(m0);",
            "%r<tr>% r1 = %cast<tp,tr>%(r0);",
            "%r<tr>% rtmp;",
            "rtmp.r = {{isa.prefix}}_vid_v_{{isa_dt_ret.data_ext}}(%N<tr>%);",
            "%r<tr>% rtmp1;",
            "rtmp1 = %set0<tr>%(1);",
            "rtmp = %andb<tr>%(rtmp,rtmp1);",
            "r1 = %andb<tr>%(r1,rtmp);",
            "return %tomsk<tr>%(r1);"
        ]
    },
    "fnmadd_int": {
        "format": "long",
        "code": [
            "%r<tp>% res = %mul<tp>%(r0, r1);",
            "%r<tp>% tmp = %set0<tp>%();",
            "res = %sub<tp>%(tmp, res);",
            "res = %add<tp>%(res, r2);",
            "return res;"
        ]
    },
    "fnmsub_int": {
        "format": "long",
        "code": [
            "%r<tp>% res = %mul<tp>%(r0, r1);",
            "%r<tp>% tmp = %set0<tp>%();",
            "res = %sub<tp>%(tmp, res);",
            "res = %sub<tp>%(res, r2);",
            "return res;"
        ]
    },
