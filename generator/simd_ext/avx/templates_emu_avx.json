            "tmp = _mm256_mul_ps(z, half);",
            "y = _mm256_sub_ps(y, tmp);",
            "",
            "tmp = _mm256_mul_ps(e, cephes_log_q2);",
            "x = _mm256_add_ps(x, y);",
