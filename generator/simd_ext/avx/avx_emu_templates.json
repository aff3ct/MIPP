{
    "cvt_f32_u32": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "__m256 two31 = _mm256_set1_ps(2147483648.0f);",
            "__m256 big = _mm256_cmp_ps(r0.r, two31, _CMP_GE_OQ);",
            "__m256 lo = _mm256_castsi256_ps(_mm256_cvttps_epi32(r0.r));",
            "__m256 hi = _mm256_xor_ps(_mm256_castsi256_ps(_mm256_cvttps_epi32(_mm256_sub_ps(r0.r, two31))), _mm256_castsi256_ps(_mm256_set1_epi32((int32_t)0x80000000)));",
            "res.r = _mm256_castps_si256(_mm256_blendv_ps(lo, hi, big));",
            "return res;"
        ]
    },
    "cvt_f64_i64": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "%r<tp>% t = %trunc<tp>%(r0);",
            "%r<tp>% y;",
            "y.r = _mm256_mul_pd(t.r, _mm256_set1_pd(2.3283064365386962890625e-10));",
            "%r<tp>% ty = %trunc<tp>%(y);",
            "__m256d hi_d = _mm256_sub_pd(ty.r, _mm256_and_pd(_mm256_cmp_pd(ty.r, y.r, _CMP_GT_OQ), _mm256_set1_pd(1.0)));",
            "__m256d lo_d = _mm256_sub_pd(t.r, _mm256_mul_pd(hi_d, _mm256_set1_pd(4294967296.0)));",
            "__m128i flip = _mm_set1_epi32((int32_t)0x80000000);",
            "__m128i lo_u = _mm_xor_si128(_mm256_cvttpd_epi32(_mm256_sub_pd(lo_d, _mm256_set1_pd(2147483648.0))), flip);",
            "{% if dt_ret.category == 'uint' %}__m128i hi_i = _mm_xor_si128(_mm256_cvttpd_epi32(_mm256_sub_pd(hi_d, _mm256_set1_pd(2147483648.0))), flip);",
            "{% else %}__m128i hi_i = _mm256_cvttpd_epi32(hi_d);{% endif %}",
            "res.r = _mm256_insertf128_si256(_mm256_castsi128_si256(_mm_unpacklo_epi32(lo_u, hi_i)), _mm_unpackhi_epi32(lo_u, hi_i), 1);",
            "return res;"
        ]
    },
    "cvt_i64_f64": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "__m128i r0_lo = _mm256_castsi256_si128(r0.r), r0_hi = _mm256_extractf128_si256(r0.r, 1);",
            "__m128i mask32 = _mm_set1_epi64x(0xFFFFFFFFLL), magic = _mm_set1_epi64x(0x4330000000000000LL);",
            "__m128d m52 = _mm_set1_pd(4503599627370496.0), two32 = _mm_set1_pd(4294967296.0);",
            "__m128d lo_lo = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_and_si128(r0_lo, mask32), magic)), m52);",
            "__m128d lo_hi = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_and_si128(r0_hi, mask32), magic)), m52);",
            "__m128d hi_lo = _mm_cvtepi32_pd(_mm_shuffle_epi32(r0_lo, _MM_SHUFFLE(3, 1, 3, 1)));",
            "__m128d hi_hi = _mm_cvtepi32_pd(_mm_shuffle_epi32(r0_hi, _MM_SHUFFLE(3, 1, 3, 1)));",
            "res.r = _mm256_insertf128_pd(_mm256_castpd128_pd256(_mm_add_pd(_mm_mul_pd(hi_lo, two32), lo_lo)), _mm_add_pd(_mm_mul_pd(hi_hi, two32), lo_hi), 1);",
            "return res;"
        ]
    },
    "cvt_u32_f32": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "__m256 x = _mm256_castsi256_ps(r0.r);",
            "__m256i lo = _mm256_castps_si256(_mm256_and_ps(x, _mm256_castsi256_ps(_mm256_set1_epi32(0x0000FFFF))));",
            "__m256i hi = _mm256_castps_si256(_mm256_and_ps(x, _mm256_castsi256_ps(_mm256_set1_epi32((int32_t)0xFFFF0000))));",
            "__m256 hi_f = _mm256_cvtepi32_ps(hi);  // signed: + 2^32 when the top bit is set",
            "hi_f = _mm256_add_ps(hi_f, _mm256_and_ps(_mm256_cmp_ps(hi_f, _mm256_setzero_ps(), _CMP_LT_OQ), _mm256_set1_ps(4294967296.0f)));",
            "res.r = _mm256_add_ps(hi_f, _mm256_cvtepi32_ps(lo));",
            "return res;"
        ]
    },
    "cvt_u64_f64": {
        "format": "long",
        "code": [
            "%r<tr>% res;",
            "__m128i r0_lo = _mm256_castsi256_si128(r0.r), r0_hi = _mm256_extractf128_si256(r0.r, 1);",
            "__m128i mask32 = _mm_set1_epi64x(0xFFFFFFFFLL), magic = _mm_set1_epi64x(0x4330000000000000LL);",
            "__m128d m52 = _mm_set1_pd(4503599627370496.0), two32 = _mm_set1_pd(4294967296.0);",
            "__m128d lo_lo = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_and_si128(r0_lo, mask32), magic)), m52);",
            "__m128d lo_hi = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_and_si128(r0_hi, mask32), magic)), m52);",
            "__m128d hi_lo = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_srli_epi64(r0_lo, 32), magic)), m52);",
            "__m128d hi_hi = _mm_sub_pd(_mm_castsi128_pd(_mm_or_si128(_mm_srli_epi64(r0_hi, 32), magic)), m52);",
            "res.r = _mm256_insertf128_pd(_mm256_castpd128_pd256(_mm_add_pd(_mm_mul_pd(hi_lo, two32), lo_lo)), _mm_add_pd(_mm_mul_pd(hi_hi, two32), lo_hi), 1);",
            "return res;"
        ]
    },
    "exp_f32": {
        "format": "long",
        "code": [
            "__m256 x = r0.r;",
            "__m256 tmp = _mm256_setzero_ps(), fx;",
            "__m256i imm0;",
            "__m256 one = _mm256_set1_ps(1.0f);",
            "__m256 half = _mm256_set1_ps(0.5f);",
            "",
            "__m256 exp_hi = _mm256_set1_ps(88.3762626647949f);",
            "__m256 exp_lo = _mm256_set1_ps(-88.3762626647949f);",
            "__m256 cephes_LOG2EF = _mm256_set1_ps(1.44269504088896341f);",
            "__m256 cephes_exp_C1 = _mm256_set1_ps(0.693359375f);",
            "__m256 cephes_exp_C2 = _mm256_set1_ps(-2.12194440e-4f);",
            "__m256 cephes_exp_p0 = _mm256_set1_ps(1.9875691500E-4f);",
            "__m256 cephes_exp_p1 = _mm256_set1_ps(1.3981999507E-3f);",
            "__m256 cephes_exp_p2 = _mm256_set1_ps(8.3334519073E-3f);",
            "__m256 cephes_exp_p3 = _mm256_set1_ps(4.1665795894E-2f);",
            "__m256 cephes_exp_p4 = _mm256_set1_ps(1.6666665459E-1f);",
            "__m256 cephes_exp_p5 = _mm256_set1_ps(5.0000001201E-1f);",
            "",
            "__m256i sevenf = _mm256_set1_epi32(0x7f);",
            "",
            "x = _mm256_min_ps(x, exp_hi);",
            "x = _mm256_max_ps(x, exp_lo);",
            "",
            "fx = _mm256_mul_ps(x, cephes_LOG2EF);",
            "fx = _mm256_add_ps(fx, half);",
            "",
            "tmp = _mm256_floor_ps(fx);",
            "",
            "__m256 mask = _mm256_cmp_ps(tmp, fx, _CMP_GT_OS);",
            "mask = _mm256_and_ps(mask, one);",
            "fx = _mm256_sub_ps(tmp, mask);",
            "",
            "tmp = _mm256_mul_ps(fx, cephes_exp_C1);",
            "__m256 z = _mm256_mul_ps(fx, cephes_exp_C2);",
            "x = _mm256_sub_ps(x, tmp);",
            "x = _mm256_sub_ps(x, z);",
            "",
            "z = _mm256_mul_ps(x, x);",
            "",
            "__m256 y = cephes_exp_p0;",
            "y = _mm256_mul_ps(y, x);",
            "y = _mm256_add_ps(y, cephes_exp_p1);",
            "y = _mm256_mul_ps(y, x);",
            "y = _mm256_add_ps(y, cephes_exp_p2);",
            "y = _mm256_mul_ps(y, x);",
            "y = _mm256_add_ps(y, cephes_exp_p3);",
            "y = _mm256_mul_ps(y, x);",
            "y = _mm256_add_ps(y, cephes_exp_p4);",
            "y = _mm256_mul_ps(y, x);",
            "y = _mm256_add_ps(y, cephes_exp_p5);",
            "",
            "y = _mm256_mul_ps(y, z);",
            "y = _mm256_add_ps(y, x);",
            "y = _mm256_add_ps(y, one);",
            "",
            "imm0 = _mm256_cvttps_epi32(fx);",
            "imm0 = _mm256_add_epi32(imm0, sevenf);",
            "imm0 = _mm256_slli_epi32(imm0, 23);",
            "__m256 pow2n = _mm256_castsi256_ps(imm0);",
            "y = _mm256_mul_ps(y, pow2n);",
            "",
            "rvd_avx_float32_t res;",
            "res.r = y;",
            "return res;",
            ""
        ]
    },
