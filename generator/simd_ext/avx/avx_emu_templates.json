            "res.r = _mm256_sllv_epi{{ dt_par.n_bits }}(_mm256_set1_epi{{ dt_par.n_bits }}{{ 'x' if dt_par.n_bits == 64 else '' }}(1), r0.r);",
            "return res;"
        ]
    },
    "rea_compress_32": {
        "format": "long",
