    "rea_permute2_32": {
        "format": "long",
        "code": [
            "// both registers permuted, the lanes of vd1 where the index has its bit 3 set",
            "__m256 x = {{ isa.prefix }}_permutevar8x32_ps({% if dt_par.category == 'float' %}vd0.vd{% else %}{{ isa.prefix }}_castsi256_ps(vd0.vd){% endif %}, vd2.vd);",
            "__m256 y = {{ isa.prefix }}_permutevar8x32_ps({% if dt_par.category == 'float' %}vd1.vd{% else %}{{ isa.prefix }}_castsi256_ps(vd1.vd){% endif %}, vd2.vd);",
            "__m256 z = {{ isa.prefix }}_blendv_ps(x, y, {{ isa.prefix }}_castsi256_ps({{ isa.prefix }}_slli_epi32(vd2.vd, 28)));",
            "%vd<tp>% res;",
            "res.vd = {% if dt_par.category == 'float' %}z{% else %}{{ isa.prefix }}_castps_si256(z){% endif %};",
            "return res;"
