    "rea_count_ps": {
        "format": "long",
        "code": [
            "return (int32_t)(__builtin_popcount((unsigned){{ isa.prefix }}_movemask_{{ 'ps' if dt_par.n_bits == 32 else 'pd' }}({% if dt_par.category == 'float' %}vm0.vm{% else %}{{ isa.prefix }}_castsi256_{{ 'ps' if dt_par.n_bits == 32 else 'pd' }}(vm0.vm){% endif %})));"
        ]
