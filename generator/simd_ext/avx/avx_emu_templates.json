    "rea_count_epi8": {
        "format": "long",
        "code": [
            "return (int32_t)(__builtin_popcount((unsigned){{ isa.prefix }}_movemask_epi8(vm0.vm)) / {{ dt_par.n_bits // 8 }});"
        ]
