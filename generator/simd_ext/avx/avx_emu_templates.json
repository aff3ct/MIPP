    "mul64": {
        "format": "long",
        "code": [
            "%vd<tp>% res;",
            "__m256i lo = _mm256_mul_epu32(vd0.vd, vd1.vd);",
            "__m256i t1 = _mm256_mul_epu32(_mm256_srli_epi64(vd0.vd, 32), vd1.vd);",
            "__m256i t2 = _mm256_mul_epu32(vd0.vd, _mm256_srli_epi64(vd1.vd, 32));",
            "res.vd = _mm256_add_epi64(lo, _mm256_slli_epi64(_mm256_add_epi64(t1, t2), 32));",
            "return res;"
        ]
    },
    "mul8": {
        "format": "long",
        "code": [
            "%vd<tp>% res;",
            "__m256i even = _mm256_mullo_epi16(vd0.vd, vd1.vd);",
            "__m256i odd = _mm256_mullo_epi16(_mm256_srli_epi16(vd0.vd, 8), _mm256_srli_epi16(vd1.vd, 8));",
            "res.vd = _mm256_or_si256(_mm256_slli_epi16(odd, 8), _mm256_and_si256(even, _mm256_set1_epi16(0x00FF)));",
            "return res;"
        ]
    },
