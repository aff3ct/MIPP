    "rea_compress_32": {
        "format": "long",
        "code": [
            "// lane indices of the active lanes (uint8 each), indexed by the movemask, then the lanes after the count zeroed",
            "static const uint8_t lut[256][8] = {{ compress_lut(lanes=8, units=1) }};",
            "const int mm = _mm256_movemask_ps({% if dt_par.category == 'float' %}vm0.vm{% else %}_mm256_castsi256_ps(vm0.vm){% endif %});",
            "__m256i idx = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i_u*)lut[mm]));",
            "__m256i keep = _mm256_cmpgt_epi32(_mm256_set1_epi32(__builtin_popcount((unsigned)mm)), _mm256_setr_epi32(0, 1, 2, 3, 4, 5, 6, 7));",
            "__m256 p = _mm256_and_ps(_mm256_permutevar8x32_ps({% if dt_par.category == 'float' %}vd0.vd{% else %}_mm256_castsi256_ps(vd0.vd){% endif %}, idx), _mm256_castsi256_ps(keep));",
            "%vd<tp>% res;",
            "res.vd = {% if dt_par.category == 'float' %}p{% else %}_mm256_castps_si256(p){% endif %};",
            "return res;"
        ]
    },
    "rea_compress_64": {
        "format": "long",
        "code": [
            "// 32-bit lane indices of the active 64-bit lanes, indexed by the movemask, then the lanes after the count zeroed",
            "static const uint8_t lut[16][8] = {{ compress_lut(lanes=4, units=2) }};",
            "const int mm = _mm256_movemask_pd({% if dt_par.category == 'float' %}vm0.vm{% else %}_mm256_castsi256_pd(vm0.vm){% endif %});",
            "__m256i idx = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i_u*)lut[mm]));",
            "__m256i keep = _mm256_cmpgt_epi64(_mm256_set1_epi64x(__builtin_popcount((unsigned)mm)), _mm256_setr_epi64x(0, 1, 2, 3));",
            "__m256 p = _mm256_and_ps(_mm256_permutevar8x32_ps({% if dt_par.category == 'float' %}_mm256_castpd_ps(vd0.vd){% else %}_mm256_castsi256_ps(vd0.vd){% endif %}, idx), _mm256_castsi256_ps(keep));",
            "%vd<tp>% res;",
            "res.vd = {% if dt_par.category == 'float' %}_mm256_castps_pd(p){% else %}_mm256_castps_si256(p){% endif %};",
            "return res;"
        ]
