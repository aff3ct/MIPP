    "mul64": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m256i lo = _mm256_mul_epu32(r0.r, r1.r);",
            "__m256i t1 = _mm256_mul_epu32(_mm256_srli_epi64(r0.r, 32), r1.r);",
            "__m256i t2 = _mm256_mul_epu32(r0.r, _mm256_srli_epi64(r1.r, 32));",
            "res.r = _mm256_add_epi64(lo, _mm256_slli_epi64(_mm256_add_epi64(t1, t2), 32));",
            "return res;"
        ]
    },
    "mul8": {
        "format": "long",
        "code": [
            "%r<tp>% res;",
            "__m256i even = _mm256_mullo_epi16(r0.r, r1.r);",
            "__m256i odd = _mm256_mullo_epi16(_mm256_srli_epi16(r0.r, 8), _mm256_srli_epi16(r1.r, 8));",
            "res.r = _mm256_or_si256(_mm256_slli_epi16(odd, 8), _mm256_and_si256(even, _mm256_set1_epi16(0x00FF)));",
            "return res;"
        ]
    },
    "notb_k_xor": {
        "format": "long",
        "code": [
            "%m<tr>% res;",
            "__m256 ones = _mm256_castsi256_ps(_mm256_set1_epi32(-1));",
            "{% if isa_dt_par.data_ext_msk == 'ps' %}res.m = _mm256_xor_ps(m0.m, ones);",
            "{% elif isa_dt_par.data_ext_msk == 'pd' %}res.m = _mm256_xor_pd(m0.m, _mm256_castps_pd(ones));",
            "{% else %}res.m = _mm256_castps_si256(_mm256_xor_ps(_mm256_castsi256_ps(m0.m), ones));{% endif %}",
            "return res;"
        ]
    },
