            "return res;"
        ]
    },
    "split_2args": {
        "format": "long",
        "code": [
            "{% set sfx = (('epu' if dt_par.category == 'uint' else 'epi') if instr_name in ['min', 'max', 'adds', 'subs'] else 'epi') ~ dt_par.n_bits %}%vd<tp>% res;",
            "__m128i r0_lo = _mm256_castsi256_si128(vd0.vd), r0_hi = _mm256_extractf128_si256(vd0.vd, 1);",
            "__m128i r1_lo = _mm256_castsi256_si128(vd1.vd), r1_hi = _mm256_extractf128_si256(vd1.vd, 1);",
            "res.vd = _mm256_insertf128_si256(_mm256_castsi128_si256(_mm_{{ instr_name }}_{{ sfx }}(r0_lo, r1_lo)), _mm_{{ instr_name }}_{{ sfx }}(r0_hi, r1_hi), 1);",
            "return res;"
        ]
    },
    "split_cmp": {
        "format": "long",
        "code": [
            "%vm<tr>% res;",
            "__m128i r0_lo = _mm256_castsi256_si128(vd0.vd), r0_hi = _mm256_extractf128_si256(vd0.vd, 1);",
            "__m128i r1_lo = _mm256_castsi256_si128(vd1.vd), r1_hi = _mm256_extractf128_si256(vd1.vd, 1);",
            "res.vm = _mm256_insertf128_si256(_mm256_castsi128_si256(_mm_{{ instr_name }}_epi{{ dt_par.n_bits }}(r0_lo, r1_lo)), _mm_{{ instr_name }}_epi{{ dt_par.n_bits }}(r0_hi, r1_hi), 1);",
            "return res;"
        ]
    },
    "split_lshift8": {
        "format": "long",
        "code": [
