    "reduce_shift": {
        "format": "long",
        "code": [
            "%vd<tp>% v = vd0;",
            "%vd<c:uint|b:8>% b = %cast<tp,c:uint|b:8>%(v);",
            "b.vd = _mm256_permute2x128_si256(b.vd, b.vd, 0x01);",
            "v = %{{ instr_name }}<tp>%(v, %cast<c:uint|b:8,tp>%(b));",
            "{% for sh in [8, 4, 2, 1] %}{% if sh * 8 >= dt_par.n_bits %}b = %cast<tp,c:uint|b:8>%(v);",
            "b.vd = _mm256_srli_si256(b.vd, {{ sh }});",
