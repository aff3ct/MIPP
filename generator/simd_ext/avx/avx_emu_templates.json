    "rshift_i64": {
        "format": "long",
        "code": [
            "%vd<tp>% res;",
            "__m256i sign = _mm256_srai_epi32(_mm256_shuffle_epi32(vd0.vd, _MM_SHUFFLE(3, 3, 1, 1)), 31);",
            "res.vd = _mm256_or_si256(_mm256_srli_epi64(vd0.vd, s0), _mm256_slli_epi64(sign, 64 - s0));",
            "return res;"
        ]
    },
    "rshift_i8": {
        "format": "long",
        "code": [
            "%vd<tp>% res;",
            "__m256i u = _mm256_xor_si256(vd0.vd, _mm256_set1_epi8((char)0x80));",
            "u = _mm256_and_si256(_mm256_srli_epi16(u, s0), _mm256_set1_epi8((char)(0xFF >> s0)));",
            "res.vd = _mm256_sub_epi8(u, _mm256_set1_epi8((char)(0x80 >> s0)));",
            "return res;"
        ]
    },
    "rshift_u8": {
        "format": "long",
        "code": [
            "%vd<tp>% res;",
