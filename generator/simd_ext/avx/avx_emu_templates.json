    "rea_permute_64": {
        "format": "long",
        "code": [
            "// the 64-bit index k as the 32-bit indices 2k and 2k + 1",
            "__m256i t = {{ isa.prefix }}_slli_epi64(vd1.vd, 1);",
            "__m256i i32 = {{ isa.prefix }}_or_si256(t, {{ isa.prefix }}_slli_epi64({{ isa.prefix }}_add_epi64(t, {{ isa.prefix }}_set1_epi64x(1)), 32));",
            "%vd<tp>% res;",
            "res.vd = {% if dt_par.category == 'float' %}{{ isa.prefix }}_castps_pd({{ isa.prefix }}_permutevar8x32_ps({{ isa.prefix }}_castpd_ps(vd0.vd), i32)){% else %}{{ isa.prefix }}_permutevar8x32_epi32(vd0.vd, i32){% endif %};",
            "return res;"
