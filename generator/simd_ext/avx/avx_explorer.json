            { "id": "AVX2", "label": "AVX2", "define": "__AVX2__", "flag": "-mavx2", "type": "tier", "default": true, "locked": false, "description": "Advanced Vector Extensions 2 (256-bit Integer)" },
            { "id": "FMA",  "label": "FMA",  "define": "__FMA__",  "flag": "-mfma",  "type": "flag", "default": true, "locked": false, "description": "Fused Multiply-Add Extensions (FMA3)" }
        ]
