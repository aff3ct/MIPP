    "msb-64": {
        "format": "long",
        "code": [
            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((int64_t)0x8000000000000000));",
            "return %andb<tp>%(r0, rm);"
        ]
