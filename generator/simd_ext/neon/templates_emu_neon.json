        ]
    },
    "mul_emu_64": {
        "format": "long",
        "code": [
            "{{isa_dt_par.to_ptr}} tab[%N<tp>%] = {",
            "\t%get<tp>%(r0, 0) * %get<tp>%(r1, 0),",
            "\t%get<tp>%(r0, 1) * %get<tp>%(r1, 1)",
            "};",
            "return %set<tp>%(tab);"
        ]
    }
