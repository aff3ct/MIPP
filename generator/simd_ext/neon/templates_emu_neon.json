    "notb": {
        "format": "long",
        "code": [
            "%r<c:int>% ones = %set1<c:int>%(-1);",
            "%r<c:int>% r0i = %cast<tp,c:int>%(r0);",
            "return %cast<c:int,tp>%(%andnb<c:int>%(r0i, ones));"
        ]
    },
    "notb_k": {
        "format": "long",
