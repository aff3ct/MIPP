    "fmadd": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% res = %add<tp>%(rmul, r2);",
            "return res;"
        ]
    },
    "fnmadd": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% tmp = %set0<tp>%();",
            "tmp = %sub<tp>%(tmp, rmul);",
            "%r<tp>% res = %add<tp>%(tmp, r2);",
            "return res;"
        ]
    },
    "fmsub": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
