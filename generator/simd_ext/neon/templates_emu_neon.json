    "set_k-xxf": {
        "format": "long",
        "code": "return %cast_k<c:int,tr>%(%set_k<c:int>%(vals));"
    },
    "set_k-64": {
        "format": "long",
        "code": [
            "uint64_t tab[%N<tp>%] = {",
            "\tvals[0] ? (uint64_t)0xFFFFFFFFFFFFFFFFU : (uint64_t)0,",
            "\tvals[1] ? (uint64_t)0xFFFFFFFFFFFFFFFFU : (uint64_t)0 };",
            "return %tomsk<tp>%(%cast<c:uint,tp>%(%set<c:uint>%(tab)));"
        ]
    },
    "set_k-32": {
