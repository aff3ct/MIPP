{
    "set0": {
        "format": "long",
        "code": "return %set1<tp>%(0);"
    },
    "set0_k": {
        "format": "long",
        "code": "return %tomsk<tp>%(%set1<tp>%(0));"
    },
    "set": {
        "format": "long",
        "code": "return %loadu<tp>%(vals);"
    },
    "get": {
        "format": "long",
        "code": [
            "%v<tp>% t[%N<tp>%];",
            "%storeu<tp>%(t, r0);",
            "return t[v0];"
        ]
    },
    "get_k": {
        "format": "long",
        "code": "return %get<tp>%(%toreg<tp>%(m0), v0);"
    },
    "set1_k-8": {
        "format": "long",
        "code": [
            "%r<c:int>% tmp1 = %set1<c:int>%(v0 ? (int8_t)0xFF : (int8_t)0);",
            "%r<tp>% tmp2 = %cast<c:int,tp>%(tmp1);",
            "return %tomsk<tp>%(tmp2);"
        ]
    },
    "set1_k-16": {
