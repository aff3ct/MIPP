{
    "arith_2args": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(r0.r, r1.r);"
    },
    "blend": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(m0.m, r0.r, r1.r);"
    },
    "cast": {
        "format": "short",
        "code": "{% if isa_dt_par.data_ext != isa_dt_ret.data_ext -%}{{ isa.prefix }}{{ instr_name }}_{{isa_dt_ret.data_ext}}_{{isa_dt_par.data_ext}}(r0.r);{% else -%} r0.r;{% endif %}"
    },
    "cast_k": {
        "format": "short",
        "code": "{% if isa_dt_par.data_ext_msk != isa_dt_ret.data_ext_msk -%}{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_ret.data_ext_msk }}_{{ isa_dt_par.data_ext_msk }}(m0.m);{% else -%} m0.m;{% endif %}"
    },
    "load": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(p0);"
    },
    "logi_2args_fxx": {
        "format": "long",
        "code": [
            "%r<c:uint>% r0i = %cast<tp,c:uint>%(r0);",
            "%r<c:uint>% r1i = %cast<tp,c:uint>%(r1);",
            "%r<c:uint>% resi;",
            "resi.r = {{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext_logi }}(r0i.r, r1i.r);",
            "return %cast<c:uint,tp>%(resi);"
        ]
    },
    "logi_2args_rev": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(r1.r, r0.r);"
    },
    "logi_2args_rev_fxx": {
        "format": "long",
        "code": [
            "%r<c:uint>% r0i = %cast<tp,c:uint>%(r0);",
            "%r<c:uint>% r1i = %cast<tp,c:uint>%(r1);",
            "%r<c:uint>% resi;",
            "resi.r = {{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext_logi }}(r1i.r, r0i.r);",
            "return %cast<c:uint,tp>%(resi);"
        ]
    },
    "logi_m_2args": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext_msk }}(m0.m, m1.m);"
    },
    "logi_m_2args_rev": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext_msk }}(m1.m, m0.m);"
    },
    "round_float": {
        "format": "short",
        "code": "{{ isa.prefix }}rndnq_{{ isa_dt_par.data_ext }}(r0.r);"
    },
    "rsqrt": {
        "format": "short",
        "code": "{{ isa.prefix }}rsqrteq_{{ isa_dt_par.data_ext }}(r0.r);"
    },
    "set1": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(v0);"
    },
    "sqrt": {
        "format": "short",
        "code": "{{ isa.prefix }}sqrtq_{{ isa_dt_par.data_ext }}(r0.r);"
    },
    "store": {
        "format": "short",
        "code": "{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_par.data_ext }}(p0, r0.r);"
    },
    "tomsk": {
        "format": "short",
        "code": "{% if isa_dt_par.data_ext != isa_dt_ret.data_ext_msk -%}{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_ret.data_ext_msk }}_{{ isa_dt_par.data_ext }}(r0.r);{% else -%} r0.r;{% endif %}"
    },
    "toreg": {
        "format": "short",
        "code": "{% if isa_dt_par.data_ext_msk != isa_dt_ret.data_ext -%}{{ isa.prefix }}{{ instr_name }}_{{ isa_dt_ret.data_ext }}_{{ isa_dt_par.data_ext_msk }}(m0.m);{% else -%} m0.m;{% endif %}"
    }
}
