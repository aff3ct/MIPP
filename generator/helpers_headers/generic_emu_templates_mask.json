    "load_msks": {
        "format": "long",
        "code": [
            "// we want to guarantee that load doesn't touch the memory of masked out elems",
            "%v<tp>% buff[%N<tp>%];",
            "for(unsigned i = 0; i < %N<tp>%; i++){",
            "\tif(%get_k<tp>%(m0, i))",
            "\t\tbuff[i] = p0[i];",
            "\telse",
            "\t\tbuff[i] = %get<tp>%(rsrc, i);",
            "}",
            "return %{{func_name}}<tp>%(buff);"
        ]
    },
    "load_mskz": {
        "format": "long",
        "code": [
            "// we want to guarantee that load doesn't touch the memory of masked out elems",
            "%v<tp>% buff[%N<tp>%];",
            "for (unsigned i = 0; i < %N<tp>%; i++) {",
            "\tif (%get_k<tp>%(m0, i))",
            "\t\tbuff[i] = p0[i];",
            "\telse",
            "\t\tbuff[i] = 0;",
            "}",
            "return %{{func_name}}<tp>%(buff);"
        ]
    },
