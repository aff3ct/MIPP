    "store_msk": {
        "format": "long",
        "code": [
            "for (unsigned i = 0; i < %N<tp>%; i++) {",
            "\tif (%get_k<tp>%(m0, i))",
            "\t\tp0[i] = %get<tp>%(r0, i);",
            "}"
        ]
