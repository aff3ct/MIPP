{
    "binary_mask_all_datatypes": {
        "format": "long",
        "code": [
            "%r<tp>% op = %{{func_name}}<tp>%(r0, r1);",
            "%r<tp>% res = %blend<tp>%(m0, op, r0);",
            "return res;"
        ]
    },
    "binary_masks_all_datatypes": {
        "format": "long",
