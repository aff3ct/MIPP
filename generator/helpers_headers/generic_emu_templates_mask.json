{
    "binary_mask_all_datatypes": {
        "format": "long",
        "code": [
            "%vd<tp>% op = %{{func_name}}<tp>%(vd0, vd1);",
            "%vd<tp>% res = %select<tp>%(vm0, op, vd0);",
            "return res;"
        ]
    },
    "binary_masks_all_datatypes": {
        "format": "long",
        "code": [
            "%vd<tp>% op = %{{func_name}}<tp>%(vd0, vd1);",
            "%vd<tp>% res = %select<tp>%(vm0, op, vdsrc);",
            "return res;"
        ]
    },
    "binary_maskz_all_datatypes": {
        "format": "long",
        "code": [
            "%vd<tp>% op = %{{func_name}}<tp>%(vd0, vd1);",
            "{% if isa.get('hw_mask', False) %}// hardware masks: a selection with zeros, which the compilers can fold into a zero-masked instruction",
            "%vd<tp>% res = %select<tp>%(vm0, op, %set0<tp>%());",
            "{%- else -%}",
            "%vd<tp>% tmp = %tovd<tp>%(vm0);",
            "%vd<tp>% res = %andb<tp>%(op, tmp);{% endif %}",
            "return res;"
        ]
    },
    "cmp_2args": {
        "format": "long",
        "code": [
            "%vm<tp>% op = %{{func_name}}<tp>%(vd0, vd1);",
            "%vm<tp>% res = %andb_k<tp>%(op, vm0);",
            "return res;"
        ]
    },
    "hadd_maskz": {
        "format": "long",
        "code": [
            "%vd<tp>% zero = %set0<tp>%();",
            "%vd<tp>% blended = %select<tp>%(vm0, vd0, zero);",
            "%s<tp>% op = %hadd<tp>%(blended);",
            "return op;"
        ]
    },
