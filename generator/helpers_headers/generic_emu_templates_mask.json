    "load_msks": {
        "format": "long",
        "code": [
            "// we want to guarantee that load doesn't touch the memory of masked out elems",
            "%s<tp>% buff[%N<tp>%];",
            "for(unsigned i = 0; i < %N<tp>%; i++){",
            "\tif(%get_k<tp>%(vm0, i))",
            "\t\tbuff[i] = p0[i];",
            "\telse",
            "\t\tbuff[i] = %get<tp>%(vdsrc, i);",
            "}",
            "return %loadu<tp>%(buff);"
        ]
    },
    "load_mskz": {
        "format": "long",
