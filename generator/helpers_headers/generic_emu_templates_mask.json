        ]
    },
    "storeu_msk": {
        "format": "long",
        "code": [
            "%s<tp>% buff[%N<tp>%];",
            "%s<tp>% mask_buff[%N<tp>%];",
            "%vd<tp>% msk_reg = %tovd<tp>%(vm0);",
            "",
            "%storeu<tp>%(buff, vd0);",
            "%storeu<tp>%(mask_buff, msk_reg);",
            "for (unsigned i = 0; i < %N<tp>%; i++)",
            "\tif (mask_buff[i])",
            "\t\tp0[i] = buff[i];"
        ]
    },
    "storeu_mskz": {
