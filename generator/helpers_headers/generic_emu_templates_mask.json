    "storeu_msk": {
        "format": "long",
        "code": [
            "%v<tp>% buff[%N<tp>%];",
            "%v<tp>% mask_buff[%N<tp>%];",
            "%r<tp>% msk_reg = %toreg<tp>%(m0);",
            "",
            "%storeu<tp>%(buff, r0);",
            "%storeu<tp>%(mask_buff, msk_reg);",
            "for (unsigned i = 0; i < %N<tp>%; i++)",
            "\tif (mask_buff[i])",
            "\t\tp0[i] = buff[i];"
        ]
    },
    "storeu_mskz": {
