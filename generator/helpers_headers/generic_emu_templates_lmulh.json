{
    "hadd": {
        "format": "long",
        "code": [
            "{% macro pair_sum(r_l, m_l, r_r, m_r, scale) -%}",
            "{% if mask_kind == 'maskz' -%}",
            "%add<c:tp|b:tp|m:{{scale}}|v:S>%({{m_l}}, %select<c:tp|b:tp|m:{{scale}}>%({{m_r}}, {{r_r}}, %set0<c:tp|b:tp|m:{{scale}}>%()), {{r_l}}, %select<c:tp|b:tp|m:{{scale}}>%({{m_r}}, {{r_r}}, %set0<c:tp|b:tp|m:{{scale}}>%()))",
            "{%- else -%}",
            "%add<c:tp|b:tp|m:{{scale}}>%({{r_l}}, {{r_r}})",
            "{%- endif %}",
            "{%- endmacro %}",
            "{% if lmul == 1 %}",
            "return %hadd<tp>%({% if mask_kind in ('maskz', 'mask') %}m0, {% elif mask_kind == 'masks' %}m0, rsrc, {% endif %}r0);",
            "{% elif lmul == 2 %}",
            "return %hadd<c:tp|b:tp|m:tp/2|v:U>%( {{ pair_sum('r0.r1', 'm0.m1', 'r0.r2', 'm0.m2', 'tp/2') }} );",
            "{% elif lmul == 4 %}",
            "return %hadd<c:tp|b:tp|m:tp/4|v:U>%(%add<c:tp|b:tp|m:tp/4>%( {{ pair_sum('r0.r1.r1', 'm0.m1.m1', 'r0.r1.r2', 'm0.m1.m2', 'tp/4') }}, {{ pair_sum('r0.r2.r1', 'm0.m2.m1', 'r0.r2.r2', 'm0.m2.m2', 'tp/4') }} ));",
            "{% elif lmul == 8 %}",
            "return %hadd<c:tp|b:tp|m:tp/8|v:U>%(%add<c:tp|b:tp|m:tp/8>%(%add<c:tp|b:tp|m:tp/8>%( {{ pair_sum('r0.r1.r1.r1', 'm0.m1.m1.m1', 'r0.r1.r1.r2', 'm0.m1.m1.m2', 'tp/8') }}, {{ pair_sum('r0.r1.r2.r1', 'm0.m1.m2.m1', 'r0.r1.r2.r2', 'm0.m1.m2.m2', 'tp/8') }} ), %add<c:tp|b:tp|m:tp/8>%( {{ pair_sum('r0.r2.r1.r1', 'm0.m2.m1.m1', 'r0.r2.r1.r2', 'm0.m2.m1.m2', 'tp/8') }}, {{ pair_sum('r0.r2.r2.r1', 'm0.m2.m2.m1', 'r0.r2.r2.r2', 'm0.m2.m2.m2', 'tp/8') }} )));",
            "{% endif %}"
        ]
    },
    "hadds": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hadds<tp>%({% if mask_kind in ('maskz', 'mask') %}m0, {% elif mask_kind == 'masks' %}m0, rsrc, {% endif %}r0);",
            "{% else %}",
            "{% if dt_par.category == 'uint' %}",
            "uint{{ dt_par.n_bits }}_t a = %hadds<c:tp|b:tp|m:tp/2{% if mask_kind == 'maskz' %}|v:Z{% else %}|v:U{% endif %}>%({% if mask_kind == 'maskz' %}m0.m1, {% endif %}r0.r1);",
            "uint{{ dt_par.n_bits }}_t b = %hadds<c:tp|b:tp|m:tp/2{% if mask_kind == 'maskz' %}|v:Z{% else %}|v:U{% endif %}>%({% if mask_kind == 'maskz' %}m0.m2, {% endif %}r0.r2);",
            "return (a > UINT{{ dt_par.n_bits }}_MAX - b) ? UINT{{ dt_par.n_bits }}_MAX : (uint{{ dt_par.n_bits }}_t)(a + b);",
            "{% else %}",
            "int{{ dt_par.n_bits }}_t a = %hadds<c:tp|b:tp|m:tp/2{% if mask_kind == 'maskz' %}|v:Z{% else %}|v:U{% endif %}>%({% if mask_kind == 'maskz' %}m0.m1, {% endif %}r0.r1);",
            "int{{ dt_par.n_bits }}_t b = %hadds<c:tp|b:tp|m:tp/2{% if mask_kind == 'maskz' %}|v:Z{% else %}|v:U{% endif %}>%({% if mask_kind == 'maskz' %}m0.m2, {% endif %}r0.r2);",
            "return (b > 0 && a > INT{{ dt_par.n_bits }}_MAX - b) ? (int{{ dt_par.n_bits }}_t)INT{{ dt_par.n_bits }}_MAX : (b < 0 && a < INT{{ dt_par.n_bits }}_MIN - b) ? (int{{ dt_par.n_bits }}_t)INT{{ dt_par.n_bits }}_MIN : (int{{ dt_par.n_bits }}_t)(a + b);",
            "{% endif %}",
            "{% endif %}"
        ]
    },
    "hmax": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmax<tp>%({% if mask_kind in ('maskz', 'mask') %}m0, {% elif mask_kind == 'masks' %}m0, rsrc, {% endif %}r0);",
            "{% else %}",
            "{% if mask_kind == 'maskz' %}",
            "%s<tp>% s1 = %hmax<c:tp|b:tp|m:tp/2|v:Z>%(m0.m1, r0.r1);",
            "%s<tp>% s2 = %hmax<c:tp|b:tp|m:tp/2|v:Z>%(m0.m2, r0.r2);",
            "{% else %}",
            "%s<tp>% s1 = %hmax<c:tp|b:tp|m:tp/2|v:U>%(r0.r1);",
            "%s<tp>% s2 = %hmax<c:tp|b:tp|m:tp/2|v:U>%(r0.r2);",
            "{% endif %}",
            "return s1 > s2 ? s1 : s2;",
            "{% endif %}"
        ]
    },
    "hmin": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmin<tp>%({% if mask_kind in ('maskz', 'mask') %}m0, {% elif mask_kind == 'masks' %}m0, rsrc, {% endif %}r0);",
            "{% else %}",
            "{% if mask_kind == 'maskz' %}",
            "%s<tp>% s1 = %hmin<c:tp|b:tp|m:tp/2|v:Z>%(m0.m1, r0.r1);",
            "%s<tp>% s2 = %hmin<c:tp|b:tp|m:tp/2|v:Z>%(m0.m2, r0.r2);",
            "{% else %}",
            "%s<tp>% s1 = %hmin<c:tp|b:tp|m:tp/2|v:U>%(r0.r1);",
            "%s<tp>% s2 = %hmin<c:tp|b:tp|m:tp/2|v:U>%(r0.r2);",
            "{% endif %}",
            "return s1 < s2 ? s1 : s2;",
            "{% endif %}"
        ]
    },
    "hmul": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmul<tp>%({% if mask_kind in ('maskz', 'mask') %}m0, {% elif mask_kind == 'masks' %}m0, rsrc, {% endif %}r0);",
            "{% else %}",
            "{% if mask_kind == 'maskz' %}",
            "%s<tp>% s1 = %hmul<c:tp|b:tp|m:tp/2|v:Z>%(m0.m1, r0.r1);",
            "%s<tp>% s2 = %hmul<c:tp|b:tp|m:tp/2|v:Z>%(m0.m2, r0.r2);",
            "{% else %}",
            "%s<tp>% s1 = %hmul<c:tp|b:tp|m:tp/2|v:U>%(r0.r1);",
            "%s<tp>% s2 = %hmul<c:tp|b:tp|m:tp/2|v:U>%(r0.r2);",
            "{% endif %}",
            "return s1 * s2;",
            "{% endif %}"
        ]
    },
    "set_k": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "%m<tp>% res = %set_k<tp>%(vals);",
            "return res;",
            "{% else %}",
            "// pass first half of the vector to ",
            "%m<tp>% res;",
            "res.m1 = %set_k<c:tp|b:tp|m:tp/2>%(vals);",
            "const int32_t *ptr = vals + %N<tp>% / 2;",
            "res.m2 = %set_k<c:tp|b:tp|m:tp/2>%(ptr);",
            "return res;",
            "{% endif %}"
        ]
    },
    "tpl_get": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %get<tp>%(r0, s0);",
            "{% else %}",
            "if(s0 < %N<tp>% / 2)",
            "\treturn %get<c:tp|b:tp|m:tp/2>%(r0.r1, s0);",
            "else {",
            "\t%s<tp>% tmp = s0 - %N<tp>% / 2;",
            "\treturn %get<c:tp|b:tp|m:tp/2>%(r0.r2, tmp);",
            "}",
            "{% endif %}"
        ]
    },
    "tpl_get_k": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %get_k<tp>%(m0, s0);",
            "{% else %}",
            "if(s0 < %N<tp>% / 2)",
            "\treturn %get_k<c:tp|b:tp|m:tp/2>%(m0.m1, s0);",
            "else {",
            "\t%s<tp>% tmp = s0 - %N<tp>% / 2;",
            "\treturn %get_k<c:tp|b:tp|m:tp/2>%(m0.m2, tmp);",
            "}",
            "{% endif %}"
        ]
    },
    "tpl_getfirst": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %getfirst<tp>%(r0);",
            "{% else %}",
            "return %getfirst<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "{% endif %}"
        ]
    },
    "tpl_none": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %none<tp>%(m0);",
            "{% else %}",
            "return %none<c:tp|b:tp|m:tp/2>%(m0.m1) && %none<c:tp|b:tp|m:tp/2>%(m0.m2);",
            "{% endif %}"
        ]
    },
    "tpl_set": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "%r<tp>% res = %set<tp>%(vals);",
            "return res;",
            "{% else %}",
            "// pass first half of the vector to ",
            "%r<tp>% res;",
            "res.r1 = %set<c:tp|b:tp|m:tp/2>%(vals);",
            "const %s<tp>% *ptr = vals + %N<tp>% / 2;",
            "res.r2 = %set<c:tp|b:tp|m:tp/2>%(ptr);",
            "return res;",
            "{% endif %}"
        ]
    },
    "tpl_testz": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %testz<tp>%(m0, m1);",
            "{% else %}",
            "return %testz<c:tp|b:tp|m:tp/2>%(m0.m1, m1.m1) && %testz<c:tp|b:tp|m:tp/2>%(m0.m2, m1.m2);",
            "{% endif %}"
        ]
    }
}