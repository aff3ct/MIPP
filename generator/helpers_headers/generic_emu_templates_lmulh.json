{
    "hadd": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hadd<tp>%(r0);",
            "{% else %}",
            "return %hadd<c:tp|b:tp|m:tp/2>%(r0.r1) + %hadd<c:tp|b:tp|m:tp/2>%(r0.r2);",
            "{% endif %}"
        ]
    },
    "hadds": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hadds<tp>%(r0);",
            "{% else %}",
            "{% if dt_par.category == 'uint' %}",
            "uint{{ dt_par.n_bits }}_t a = %hadds<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "uint{{ dt_par.n_bits }}_t b = %hadds<c:tp|b:tp|m:tp/2>%(r0.r2);",
            "return (a > UINT{{ dt_par.n_bits }}_MAX - b) ? UINT{{ dt_par.n_bits }}_MAX : (uint{{ dt_par.n_bits }}_t)(a + b);",
            "{% else %}",
            "int{{ dt_par.n_bits }}_t a = %hadds<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "int{{ dt_par.n_bits }}_t b = %hadds<c:tp|b:tp|m:tp/2>%(r0.r2);",
            "return (b > 0 && a > INT{{ dt_par.n_bits }}_MAX - b) ? (int{{ dt_par.n_bits }}_t)INT{{ dt_par.n_bits }}_MAX : (b < 0 && a < INT{{ dt_par.n_bits }}_MIN - b) ? (int{{ dt_par.n_bits }}_t)INT{{ dt_par.n_bits }}_MIN : (int{{ dt_par.n_bits }}_t)(a + b);",
            "{% endif %}",
            "{% endif %}"
        ]
    },
    "hmax": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmax<tp>%(r0);",
            "{% else %}",
            "%v<tp>% v1, v2;",
            "v1 = %hmax<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "v2 = %hmax<c:tp|b:tp|m:tp/2>%(r0.r2);",
            "return v1 > v2 ? v1 : v2;",
            "{% endif %}"
        ]
    },
    "hmin": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmin<tp>%(r0);",
            "{% else %}",
            "%v<tp>% v1, v2;",
            "v1 = %hmin<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "v2 = %hmin<c:tp|b:tp|m:tp/2>%(r0.r2);",
            "return v1 < v2 ? v1 : v2;",
            "{% endif %}"
        ]
    },
    "hmul": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %hmul<tp>%(r0);",
            "{% else %}",
            "%v<tp>% v1, v2;",
            "v1 = %hmul<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "v2 = %hmul<c:tp|b:tp|m:tp/2>%(r0.r2);\t",
            "return v1 * v2;",
            "{% endif %}"
        ]
    },
    "set_k": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "%m<tp>% res = %set_k<tp>%(vals);",
            "return res;",
            "{% else %}",
            "// pass first half of the vector to ",
            "%m<tp>% res;",
            "res.m1 = %set_k<c:tp|b:tp|m:tp/2>%(vals);",
            "const int32_t *ptr = vals + %N<tp>% / 2;",
            "res.m2 = %set_k<c:tp|b:tp|m:tp/2>%(ptr);",
            "return res;",
            "{% endif %}"
        ]
    },
    "tpl_get": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %get<tp>%(r0, v0);",
            "{% else %}",
            "if(v0 < %N<tp>% / 2)",
            "\treturn %get<c:tp|b:tp|m:tp/2>%(r0.r1, v0);",
            "else {",
            "\t%v<tp>% tmp = v0 - %N<tp>% / 2;",
            "\treturn %get<c:tp|b:tp|m:tp/2>%(r0.r2, tmp);",
            "}",
            "{% endif %}"
        ]
    },
    "tpl_get_k": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %get_k<tp>%(m0, v0);",
            "{% else %}",
            "if(v0 < %N<tp>% / 2)",
            "\treturn %get_k<c:tp|b:tp|m:tp/2>%(m0.m1, v0);",
            "else {",
            "\t%v<tp>% tmp = v0 - %N<tp>% / 2;",
            "\treturn %get_k<c:tp|b:tp|m:tp/2>%(m0.m2, tmp);",
            "}",
            "{% endif %}"
        ]
    },
    "tpl_getfirst": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %getfirst<tp>%(r0);",
            "{% else %}",
            "return %getfirst<c:tp|b:tp|m:tp/2>%(r0.r1);",
            "{% endif %}"
        ]
    },
    "tpl_set": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "%r<tp>% res = %set<tp>%(vals);",
            "return res;",
            "{% else %}",
            "// pass first half of the vector to ",
            "%r<tp>% res;",
            "res.r1 = %set<c:tp|b:tp|m:tp/2>%(vals);",
            "const %v<tp>% *ptr = vals + %N<tp>% / 2;",
            "res.r2 = %set<c:tp|b:tp|m:tp/2>%(ptr);",
            "return res;",
            "{% endif %}"
        ]
    },
    "tpl_testz": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %testz<tp>%(m0, m1);",
            "{% else %}",
            "return %testz<c:tp|b:tp|m:tp/2>%(m0.m1, m1.m1) && %testz<c:tp|b:tp|m:tp/2>%(m0.m2, m1.m2);",
            "{% endif %}"
        ]
    },
    "tpl_testz_2": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %testz_2<tp>%(m0);",
            "{% else %}",
            "return %testz_2<c:tp|b:tp|m:tp/2>%(m0.m1) && %testz_2<c:tp|b:tp|m:tp/2>%(m0.m2);",
            "{% endif %}"
        ]
    },
    "wcvt": {
        "format": "long",
        "code": [
            "{% if lmul == 1 %}",
            "return %wcvt<tp>%(r0);",
            "{% else %}",
            "// scalar backup bc we would need mipp::high to deal with it",
            "%v<tp>% tmp_p[%N<tp>%];",
            "%store<tp>%(&tmp_p[0], r0);",
            "%v<tr>% tmp_r[%N<tr>%];",
            "for (int i = 0; i < %N<tr>%; i++)",
            "\ttmp_r[i] = tmp_p[i];",
            "return %load<tr>%(&tmp_r[0]);",
            "{% endif %}"
        ]
    }
}
