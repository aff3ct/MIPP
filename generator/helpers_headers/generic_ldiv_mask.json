    "combine": [
        {
            "level": 3,
            "variants": [
                "u"
            ],
            "code": [
                "%r<tr>% res;",
                "{{ wrap('r0', 'r1') }}",
                "%s<tp>% buf[2 * %N<tp|m:tp*2>%] = {0};",
                "{{ call1('storeu', 'buf', 'w_r0') }};",
                "{{ call1('storeu', 'buf + %N<tp>%', 'w_r1') }};",
                "res.r = {{ call1('loadu', 'buf') }}.r;",
                "return res;"
            ]
        }
    ],
