{
    "blend": {
        "format": "long",
        "code": [
            "%v<tp>% ptr1[%N<tp>%];",
            "%v<tp>% ptr2[%N<tp>%];",
            "%store<tp>%(ptr1, r0);",
            "%store<tp>%(ptr2, r1);",
            "for(unsigned i = 0; i < %N<tp>%; i++) {",
            "\tptr1[i] = %get_k<tp>%(m0, i) ? ptr1[i] : ptr2[i];",
            "}",
            "return %load<tp>%(ptr1);"
        ]
    },
    "cmpneq": {
        "format": "long",
        "code": "return %notb_k<tp>%(%cmpeq<tp>%(r0, r1));"
    },
    "div2": {
        "format": "long",
        "code": [
            "%r<tp>% tmp = %set1<tp>%(2);",
            "%r<tp>% res = %div<tp>%(r0, tmp);",
            "return res;"
        ]
    },
    "div4": {
        "format": "long",
        "code": [
            "%r<tp>% tmp = %set1<tp>%(4);",
            "%r<tp>% res = %div<tp>%(r0, tmp);",
            "return res;"
        ]
    },
    "fmadd": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% res = %add<tp>%(rmul, r2);",
            "return res;"
        ]
    },
    "fmsub": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% res = %sub<tp>%(rmul, r2);",
            "return res;"
        ]
    },
    "fnmadd": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% tmp = %set0<tp>%();",
            "tmp = %sub<tp>%(tmp, rmul);",
            "%r<tp>% res = %add<tp>%(tmp, r2);",
            "return res;"
        ]
    },
    "fnmsub": {
        "format": "long",
        "code": [
            "%r<tp>% rmul = %mul<tp>%(r0, r1);",
            "%r<tp>% tmp = %set0<tp>%();",
            "tmp = %sub<tp>%(tmp, rmul);",
            "%r<tp>% res = %sub<tp>%(tmp, r2);",
            "return res;"
        ]
    },
    "get": {
        "format": "long",
        "code": [
            "%v<tp>% t[%N<tp>%];",
            "%storeu<tp>%(t, r0);",
            "return t[v0];"
        ]
    },
    "get_k": {
        "format": "long",
        "code": "return %get<tp>%(%toreg<tp>%(m0), v0);"
    },
    "max_emu": {
        "format": "long",
        "code": "return %blend<tp>%(r0, r1, %cmpgt<tp>%(r0, r1));"
    },
    "min_emu": {
        "format": "long",
        "code": "return %blend<tp>%(r0, r1, %cmplt<tp>%(r0, r1));"
    },
    "msb-16": {
        "format": "long",
        "code": [
            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((int16_t)0x8000));",
            "return %andb<tp>%(r0, rm);"
        ]
    },
    "msb-32": {
        "format": "long",
        "code": [
            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((int32_t)0x80000000));",
            "return %andb<tp>%(r0, rm);"
        ]
    },
    "msb-64": {
        "format": "long",
        "code": [
            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((int64_t)0x8000000000000000));",
            "return %andb<tp>%(r0, rm);"
        ]
    },
    "msb-8": {
        "format": "long",
        "code": [
            "%r<tp>% rm = %cast<c:int|b:tp,tp>%(%set1<c:int|b:tp>%((int8_t)0x80));",
            "return %andb<tp>%(r0, rm);"
        ]
    },
    "notb": {
        "format": "long",
        "code": [
            "%r<c:int>% ones = %set1<c:int>%(-1);",
            "%r<c:int>% r0i = %cast<tp,c:int>%(r0);",
            "return %cast<c:int,tp>%(%andnb<c:int>%(r0i, ones));"
        ]
    },
    "notb_k": {
        "format": "long",
        "code": [
            "%r<c:int>% ones = %set1<c:int>%(-1);",
            "%r<c:int>% r0i = %cast<tp,c:int>%(%toreg<tp>%(m0));",
            "return %tomsk<tp>%(%cast<c:int,tp>%(%andnb<c:int>%(r0i, ones)));"
        ]
    },
    "round_int": {
        "format": "short",
        "code": "r0.r;"
    },
    "set": {
        "format": "long",
        "code": "return %loadu<tp>%(vals);"
    },
    "set0": {
        "format": "long",
        "code": "return %set1<tp>%(0);"
    },
    "set0_k": {
        "format": "long",
        "code": "return %tomsk<tp>%(%set1<tp>%(0));"
    },
    "set1_k-16": {
        "format": "long",
        "code": [
            "%r<c:int>% tmp1 = %set1<c:int>%(v0 ? (int16_t)0xFFFF : (int16_t)0);",
            "%r<tp>% tmp2 = %cast<c:int,tp>%(tmp1);",
            "return %tomsk<tp>%(tmp2);"
        ]
    },
    "set1_k-32": {
        "format": "long",
        "code": [
            "%r<c:int>% tmp1 = %set1<c:int>%(v0 ? (int32_t)0xFFFFFFFF : (int32_t)0);",
            "%r<tp>% tmp2 = %cast<c:int,tp>%(tmp1);",
            "return %tomsk<tp>%(tmp2);"
        ]
    },
    "set1_k-64": {
        "format": "long",
        "code": [
            "%r<c:int>% tmp1 = %set1<c:int>%(v0 ? (int64_t)0xFFFFFFFFFFFFFFFF : (int64_t)0);",
            "%r<tp>% tmp2 = %cast<c:int,tp>%(tmp1);",
            "return %tomsk<tp>%(tmp2);"
        ]
    },
    "set1_k-8": {
        "format": "long",
        "code": [
            "%r<c:int>% tmp1 = %set1<c:int>%(v0 ? (int8_t)0xFF : (int8_t)0);",
            "%r<tp>% tmp2 = %cast<c:int,tp>%(tmp1);",
            "return %tomsk<tp>%(tmp2);"
        ]
    },
    "set_k-16": {
        "format": "long",
        "code": [
            "uint16_t tab[%N<tp>%] = {",
            "\tvals[ 0] ? (uint16_t)0xFFFFU : (uint16_t)0, vals[ 1] ? (uint16_t)0xFFFFU : (uint16_t)0,",
            "\tvals[ 2] ? (uint16_t)0xFFFFU : (uint16_t)0, vals[ 3] ? (uint16_t)0xFFFFU : (uint16_t)0,",
            "\tvals[ 4] ? (uint16_t)0xFFFFU : (uint16_t)0, vals[ 5] ? (uint16_t)0xFFFFU : (uint16_t)0,",
            "\tvals[ 6] ? (uint16_t)0xFFFFU : (uint16_t)0, vals[ 7] ? (uint16_t)0xFFFFU : (uint16_t)0 };",
            "return %tomsk<tp>%(%cast<c:uint,tp>%(%set<c:uint>%(tab)));"
        ]
    },
    "set_k-32": {
        "format": "long",
        "code": [
            "uint32_t tab[%N<tp>%] = {",
            "\tvals[0] ? (uint32_t)0xFFFFFFFFU : (uint32_t)0, vals[1] ? (uint32_t)0xFFFFFFFFU : (uint32_t)0,",
            "\tvals[2] ? (uint32_t)0xFFFFFFFFU : (uint32_t)0, vals[3] ? (uint32_t)0xFFFFFFFFU : (uint32_t)0 };",
            "return %tomsk<tp>%(%cast<c:uint,tp>%(%set<c:uint>%(tab)));"
        ]
    },
    "set_k-64": {
        "format": "long",
        "code": [
            "uint64_t tab[%N<tp>%] = {",
            "\tvals[0] ? (uint64_t)0xFFFFFFFFFFFFFFFFU : (uint64_t)0,",
            "\tvals[1] ? (uint64_t)0xFFFFFFFFFFFFFFFFU : (uint64_t)0 };",
            "return %tomsk<tp>%(%cast<c:uint,tp>%(%set<c:uint>%(tab)));"
        ]
    },
    "set_k-8": {
        "format": "long",
        "code": [
            "uint8_t tab[%N<tp>%] = {",
            "\tvals[ 0] ? (uint8_t)0xFFU : (uint8_t)0, vals[ 1] ? (uint8_t)0xFFU : (uint8_t)0, vals[ 2] ? (uint8_t)0xFFU : (uint8_t)0, (uint8_t)vals[ 3] ? (uint8_t)0xFFU : (uint8_t)0,",
            "\tvals[ 4] ? (uint8_t)0xFFU : (uint8_t)0, vals[ 5] ? (uint8_t)0xFFU : (uint8_t)0, vals[ 6] ? (uint8_t)0xFFU : (uint8_t)0, (uint8_t)vals[ 7] ? (uint8_t)0xFFU : (uint8_t)0,",
            "\tvals[ 8] ? (uint8_t)0xFFU : (uint8_t)0, vals[ 9] ? (uint8_t)0xFFU : (uint8_t)0, vals[10] ? (uint8_t)0xFFU : (uint8_t)0, (uint8_t)vals[11] ? (uint8_t)0xFFU : (uint8_t)0,",
            "\tvals[12] ? (uint8_t)0xFFU : (uint8_t)0, vals[13] ? (uint8_t)0xFFU : (uint8_t)0, vals[14] ? (uint8_t)0xFFU : (uint8_t)0, (uint8_t)vals[15] ? (uint8_t)0xFFU : (uint8_t)0 };",
            "return %tomsk<tp>%(%cast<c:uint,tp>%(%set<c:uint>%(tab)));"
        ]
    },
    "set_k-xxf": {
        "format": "long",
        "code": "return %cast_k<c:int,tr>%(%set_k<c:int>%(vals));"
    }
}
