            "%r<c:int|b:tp>% r0s = %cast<tp,c:int|b:tp>%(r0_biased);",
            "%r<c:int|b:tp>% r1s = %cast<tp,c:int|b:tp>%(r1_biased);",
            "return %cast_k<c:int|b:tp,tp>%(%cmpgt<c:int|b:tp>%(r0s, r1s));"
        ]
    },
