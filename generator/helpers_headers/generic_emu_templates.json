{
    "andb_k_emu": {
        "format": "long",
        "code": [
            "%r<tp>% tmp1 = %toreg<tp>%(m0);",
            "%r<tp>% tmp2 = %toreg<tp>%(m1);",
            "%r<tp>% res = %andb<tp>%(tmp1, tmp2);",
            "return %tomsk<tp>%(res);"
        ]
    },
    "andnb_k_emu": {
        "format": "long",
        "code": [
            "%r<tp>% tmp1 = %toreg<tp>%(m0);",
            "%r<tp>% tmp2 = %toreg<tp>%(m1);",
            "%r<tp>% res = %andnb<tp>%(tmp1, tmp2);",
            "return %tomsk<tp>%(res);"
        ]
    },
    "arith_2args_u": {
        "format": "long",
        "code": [
            "%r<c:int|b:tp>% r0u = %cast<tp,c:int|b:tp>%(r0);",
            "%r<c:int|b:tp>% r1u = %cast<tp,c:int|b:tp>%(r1);",
            "%r<c:int|b:tp>% res = %{{ instr_name }}<c:int|b:tp>%(r0u, r1u);",
            "return %cast<c:int|b:tp,tp>%(res);"
        ]
    },
    "blend": {
        "format": "long",
        "code": [
            "%v<tp>% ptr1[%N<tp>%];",
            "%v<tp>% ptr2[%N<tp>%];",
            "%store<tp>%(ptr1, r0);",
            "%store<tp>%(ptr2, r1);",
            "for(unsigned i = 0; i < %N<tp>%; i++) {",
            "\tptr1[i] = %get_k<tp>%(m0, i) ? ptr1[i] : ptr2[i];",
            "}",
            "return %load<tp>%(ptr1);"
        ]
    },
    "blend_via_andnot_ps_emu": {
        "format": "long",
        "code": [
            "%r<c:float|b:32>% rmi = %cast<tp,c:float|b:32>%(%toreg<tp>%(m0));",
            "%r<c:float|b:32>% r0i = %cast<tp,c:float|b:32>%(r0);",
            "%r<c:float|b:32>% r1i = %cast<tp,c:float|b:32>%(r1);",
            "%r<c:float|b:32>% resi = %orb<c:float|b:32>%(%andb<c:float|b:32>%(r0i, rmi), %andnb<c:float|b:32>%(rmi, r1i));",
            "return %cast<c:float|b:32,tr>%(resi);"
        ]
    },
    "blend_via_float_emu": {
        "format": "long",
        "code": [
            "%r<c:float|b:tp>% r0f = %cast<tp,c:float|b:tp>%(r0);",
            "%r<c:float|b:tp>% r1f = %cast<tp,c:float|b:tp>%(r1);",
            "%m<c:float|b:tp>% m0f = %cast_k<tp,c:float|b:tp>%(m0);",
            "%r<c:float|b:tp>% resf = %blend<c:float|b:tp>%(r0f, r1f, m0f);",
            "return %cast<c:float|b:tp,tp>%(resf);"
        ]
    },
    "cmpeq_u": {
        "format": "long",
        "code": [
            "%r<c:int|b:tp>% r0s = %cast<tp,c:int|b:tp>%(r0);",
            "%r<c:int|b:tp>% r1s = %cast<tp,c:int|b:tp>%(r1);",
            "return %cast_k<c:int|b:tp,tp>%(%cmpeq<c:int|b:tp>%(r0s, r1s));"
        ]
    },
    "cmpeq_via_cast_emu": {
        "format": "long",
        "code": [
            "return %cast_k<c:float,tp>%(%cmpeq<c:float>%(%cast<tp,c:float>%(r0), %cast<tp,c:float>%(r1)));"
        ]
    },
    "cmpge_u_emu": {
        "format": "long",
        "code": "return %notb_k<tp>%(%cmpgt<tp>%(r1, r0));"
    },
    "cmpgt_u-16": {
        "format": "long",
        "code": [
            "%r<tp>% bias = %set1<tp>%((int16_t)0x8000);",
            "%r<tp>% r0_biased = %xorb<tp>%(r0, bias);",
            "%r<tp>% r1_biased = %xorb<tp>%(r1, bias);",
            "%r<c:int|b:tp>% r0s = %cast<tp,c:int|b:tp>%(r0_biased);",
            "%r<c:int|b:tp>% r1s = %cast<tp,c:int|b:tp>%(r1_biased);",
            "return %cast_k<c:int|b:tp,tp>%(%cmpgt<c:int|b:tp>%(r0s, r1s));"
        ]
    },
