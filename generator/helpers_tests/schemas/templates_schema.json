{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Test Templates",
    "description": "Code templates of the generated tests, in `helpers_tests/tests_templates.json`, grouped by section and by API (`c`, `cpp`, `obj`, or `all`). A template is a list of lines with `{{placeholder}}` variables, filled by `tests_builder.py`; the `%token<params>(args)%` markers are translated for each API by `dialect_adapters.py`.",
    "additionalProperties": false,
    "definitions": {
        "template_map": {
            "description": "Named templates: each value is an array of template strings with {{placeholder}} variables.",
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "propertyNames": {
                "title": "template"
            }
        }
    },
    "properties": {
        "assertions": {
            "description": "Assertion snippets grouped by dialect namespace.",
            "type": "object",
            "properties": {
                "c": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        },
        "headers": {
            "description": "Fixed include blocks grouped by dialect namespace.",
            "type": "object",
            "properties": {
                "c": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        },
        "func_templates": {
            "description": "Structural boilerplate (function signatures, load blocks, section wrappers, lambdas) grouped by dialect namespace.",
            "type": "object",
            "properties": {
                "c": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "assertions",
        "headers",
        "func_templates"
    ],
    "type": "object"
}
