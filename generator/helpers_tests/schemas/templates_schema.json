                "c": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp_obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        }
