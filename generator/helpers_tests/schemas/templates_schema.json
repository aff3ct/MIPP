{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
        "template_map": {
            "type": "object",
            "description": "Named templates: each value is an array of template strings with {{placeholder}} variables.",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            }
        }
    },
    "description": "Reusable templates for generated test files, organised by section and dialect namespace (c, cpp, obj, cpp_obj, all).",
    "properties": {
        "assertions": {
            "type": "object",
            "description": "Assertion snippets grouped by dialect namespace.",
            "properties": {
