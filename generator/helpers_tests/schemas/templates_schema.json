                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp_obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        },
        "headers": {
            "type": "object",
            "description": "Fixed include blocks grouped by dialect namespace.",
            "properties": {
                "c": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp": {
                    "$ref": "#/definitions/template_map"
                },
                "obj": {
                    "$ref": "#/definitions/template_map"
                },
                "cpp_obj": {
                    "$ref": "#/definitions/template_map"
                },
                "all": {
                    "$ref": "#/definitions/template_map"
                }
            },
            "additionalProperties": false
        },
        "func_templates": {
            "type": "object",
