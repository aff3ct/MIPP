        "is_loop": { "type": "boolean" },
        "components": {
          "type": "object",
          "properties": {
            "decl": { "type": "string" },
            "init": { "type": "string" },
            "load": { "type": "string" },
            "operation": { "type": "string" },
            "loop_body": { "type": "string" },
            "loop_assert": { "type": "string" }
