    "cvt_helpers_cpp": [
      "#ifndef MIPP_TEST_HELPERS_HPP",
      "#define MIPP_TEST_HELPERS_HPP",
      "namespace mipp {",
      "namespace test_helpers {",
      "template <typename T_dst, typename Reg>",
      "inline auto cvt(const Reg& r0) {",
      "    if constexpr (std::is_same_v<T_dst, double>) return mipp::cvt_float64(r0);",
      "    else if constexpr (std::is_same_v<T_dst, float>) return mipp::cvt_float32(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int64_t> || std::is_same_v<T_dst, uint64_t>) return mipp::cvt_int64(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int32_t> || std::is_same_v<T_dst, uint32_t>) return mipp::cvt_int32(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int16_t> || std::is_same_v<T_dst, uint16_t>) return mipp::cvt_int16(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int8_t> || std::is_same_v<T_dst, uint8_t>) return mipp::cvt_int8(r0);",
      "}",
      "template <typename T_dst, typename Reg>",
      "inline auto wcvt(const Reg& r0) {",
      "    if constexpr (std::is_same_v<T_dst, double>) return mipp::wcvt_float64(mipp::cast_float32(r0));",
      "    else if constexpr (std::is_same_v<T_dst, int64_t> || std::is_same_v<T_dst, uint64_t>) return mipp::wcvt_int64(mipp::cast_int32(r0));",
      "    else if constexpr (std::is_same_v<T_dst, int32_t> || std::is_same_v<T_dst, uint32_t>) return mipp::wcvt_int32(mipp::cast_int16(r0));",
      "    else if constexpr (std::is_same_v<T_dst, int16_t> || std::is_same_v<T_dst, uint16_t>) return mipp::wcvt_int16(mipp::cast_int8(r0));",
      "}",
      "template <typename T_dst, typename Reg>",
      "inline auto cast(const Reg& r0) {",
      "    if constexpr (std::is_same_v<T_dst, double>) return mipp::cast_float64(r0);",
      "    else if constexpr (std::is_same_v<T_dst, float>) return mipp::cast_float32(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int64_t> || std::is_same_v<T_dst, uint64_t>) return mipp::cast_int64(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int32_t> || std::is_same_v<T_dst, uint32_t>) return mipp::cast_int32(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int16_t> || std::is_same_v<T_dst, uint16_t>) return mipp::cast_int16(r0);",
      "    else if constexpr (std::is_same_v<T_dst, int8_t> || std::is_same_v<T_dst, uint8_t>) return mipp::cast_int8(r0);",
      "}",
      "template <typename T_dst, typename Msk>",
      "inline auto cast_k(const Msk& m0) {",
      "    if constexpr (sizeof(T_dst) == 8) return mipp::cast_int64(m0);",
      "    else if constexpr (sizeof(T_dst) == 4) return mipp::cast_int32(m0);",
      "    else if constexpr (sizeof(T_dst) == 2) return mipp::cast_int16(m0);",
      "    else if constexpr (sizeof(T_dst) == 1) return mipp::cast_int8(m0);",
      "}",
      "}",
      "}",
      "#endif"
    ]
