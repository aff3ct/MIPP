    "as_reduction_overflow_check": [
      "bool ov = false;",
      "{",
      "\tif constexpr (!std::is_floating_point_v<T>)",
      "\t{",
      "\t\tconst int32_t* m_ptr = nullptr;",
      "\t\tbool is_z = (MK == mipp::Z);",
      "\t\tif constexpr (MK == mipp::Z || MK == mipp::M || MK == mipp::S) m_ptr = inputs_m;",
      "\t\tov = ovf::will_reduction_hadd_overflow<T>(inputs1, size, m_ptr, is_z);",
