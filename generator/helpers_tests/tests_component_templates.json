    "as_reduction_mul_overflow_check": [
      "bool ov = false;",
      "{",
      "\tif constexpr (!std::is_floating_point_v<T>)",
      "\t{",
      "\t\tauto get_val = [&](size_t idx) -> T {",
      "\t\t\tif constexpr (MK == mipp::Z) return inputs_m[idx] ? inputs1[idx] : static_cast<T>(0);",
      "\t\t\telse return inputs1[idx];",
      "\t\t};",
      "\t\tT acc = get_val(0);",
      "\t\tfor (size_t i = 1; i < size; i++)",
      "\t\t{",
      "\t\t\tT v = get_val(i);",
      "\t\t\tif (ovf::will_mul_overflow<T>(acc, v)) { ov = true; break; }",
      "\t\t\tacc = acc * v;",
      "\t\t}",
      "\t}",
